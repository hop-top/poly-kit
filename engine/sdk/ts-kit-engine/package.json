{
  "name": "@hop-top/kit-engine",
  "version": "0.1.0",
  "description": "TypeScript SDK for kit serve — identity, storage, sync, peers via sidecar",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "scripts/install.js"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts",
