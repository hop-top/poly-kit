    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "kit": {
    "version": "0.5.0-alpha.16"
  },
  "engines": {
    "node": ">=20"
  },
