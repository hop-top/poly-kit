[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{.Name}}"
version = "0.0.0"
description = "{{.Description}}"
readme = "README.md"
license = "{{.License}}"
requires-python = ">=3.12"
authors = [
    { name = "{{.Author}}", email = "{{.Email}}" },
]
dependencies = [
    "hop-top-kit>=0.5.0-alpha.10", {{- /* x-release-please-version */}}
    "typer>=0.12.0",
]

[project.scripts]
"{{.Name}}" = "{{.Name}}.cli:app"

[dependency-groups]
dev = [
    "pytest>=8.0.0",
    "pytest-cov>=7.1.0",
    "mypy>=1.10.0",
    "ruff>=0.5.0",
    # Quality gates (`make quality`, `make mutation`).
    "pip-audit>=2.10.1",
    "deptry>=0.25.1",
    "vulture>=2.16",
    "twine>=7.0.0",
    "mutmut>=3.8.0",
]

[tool.hatch.build.targets.wheel]
packages = ["src/{{.Name}}"]

[tool.mypy]
python_version = "3.12"
strict = true
warn_return_any = true
warn_unused_configs = true

[tool.pytest.ini_options]
testpaths = ["tests"]
# src first on sys.path: `make mutation` runs the suite against the
# mutated copy, not the editable install.
pythonpath = ["src"]

[tool.coverage.run]
source = ["src"]
branch = true

[tool.coverage.report]
show_missing = true
skip_covered = true

[tool.vulture]
paths = ["src", "tests"]
min_confidence = 80

[tool.mutmut]
source_paths = ["src/"]
