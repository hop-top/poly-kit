[package]
name = "{{.CrateName}}"
version = "0.0.0"
edition = "2024"
license = "{{.License}}"
description = "{{.Description}}"
authors = ["{{.Author}} <{{.Email}}>"]

[[bin]]
name = "{{.Name}}"
path = "src/main.rs"

[dependencies]
clap = { version = "4", features = ["derive", "string"] }
hop-top-kit = { version = "0.5.0-alpha.7", features = ["cli"] } {{- /* x-release-please-version */}}
serde_json = "1"

[dev-dependencies]
assert_cmd = "2"
predicates = "3"

[lints.rust]
unsafe_code = "deny"

[lints.clippy]
all = { level = "warn", priority = -1 }
# Threshold in clippy.toml. A function over it is split, not exempted.
cognitive_complexity = "warn"
