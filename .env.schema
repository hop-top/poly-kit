# Environment schema for local dev and live smoke runs (varlock).
#
# Unit tests never read these: they use loopback mock servers and fake
# keys built at runtime. Real provider keys are only for opt-in live
# runs, injected at run time, never written to a committed file:
#
#   npx varlock@1.23.0 run -- cargo test --all-features -- --ignored
#
# Values come from the shell, a git-ignored .env.local, or a secret
# store wired into this schema locally.
#
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Generic fallback key for any LLM scheme without its own variable.
LLM_API_KEY=
# Base URL override; keys from the environment are only sent to it,
# the provider default, loopback, or an llm.yaml base_url.
# @sensitive=false @type=url
LLM_BASE_URL=
# Per-provider base URL overrides.
# @sensitive=false @type=url
ANTHROPIC_BASE_URL=
# @sensitive=false @type=url
ROUTELLM_BASE_URL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# @sensitive=false
OPENAI_ORG_ID=
# @sensitive=false
OPENAI_PROJECT_ID=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_KEY=
TRITON_API_KEY=
ROUTELLM_API_KEY=

# OpenAI-compatible schemes (<SCHEME>_API_KEY).
OPENROUTER_API_KEY=
XAI_API_KEY=
LMSTUDIO_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
