{
  "$defs": {
    "Plan": {
      "description": "A reviewed dry-run, stored by the core and applied by id.",
      "properties": {
        "args": true,
        "capability": {
          "type": "string"
        },
        "created_at": {
          "description": "RFC 3339 timestamp.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "rendered": true
      },
      "required": [
        "id",
        "capability",
        "args",
        "rendered",
        "idempotency_key",
        "created_at"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Outcome of applying a plan; `Drifted` means the fresh dry-run differs\nfrom the reviewed plan and nothing was executed.",
  "oneOf": [
    {
      "properties": {
        "body": true,
        "kind": {
          "const": "applied",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "body"
      ],
      "type": "object"
    },
    {
      "properties": {
        "body": {
          "properties": {
            "diff": true,
            "fresh": {
              "$ref": "#/$defs/Plan"
            }
          },
          "required": [
            "fresh",
            "diff"
          ],
          "type": "object"
        },
        "kind": {
          "const": "drifted",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "body"
      ],
      "type": "object"
    },
    {
      "properties": {
        "body": {
          "properties": {
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "reason"
          ],
          "type": "object"
        },
        "kind": {
          "const": "blocked",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "body"
      ],
      "type": "object"
    }
  ],
  "title": "ApplyResponse"
}
