{
  "$defs": {
    "ErrorKind": {
      "description": "What went wrong, coarsely, so the UI can branch on it.",
      "oneOf": [
        {
          "const": "unconfigured",
          "description": "Env is missing or unusable: no core to talk to.",
          "type": "string"
        },
        {
          "const": "offline",
          "description": "The core did not answer connect (down, refused, wrong contract).",
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "The core answered 503: it cannot serve now.",
          "type": "string"
        },
        {
          "const": "unauthorized",
          "description": "The core refused the bearer.",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "The route does not exist.",
          "type": "string"
        },
        {
          "const": "forbidden",
          "description": "The path is not one the webview may read.",
          "type": "string"
        },
        {
          "const": "invalid_intent",
          "description": "The intent does not name a valid shell topic.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Any other failure.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Error handed to the webview: `{ \"kind\": ..., \"reason\": ... }`.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/ErrorKind"
    },
    "reason": {
      "type": "string"
    }
  },
  "required": [
    "kind",
    "reason"
  ],
  "title": "DekError",
  "type": "object"
}
