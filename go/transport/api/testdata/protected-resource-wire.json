{
  "_comment": "Generated by go test ./go/transport/api -run TestProtectedResourceWire -update-auth-wire. The MCP authorization flow (RFC 9728) at the HTTP edge of every kit MCP mount.",
  "resource": "https://mcp.example.com/mcp",
  "authorization_servers": [
    "https://login.example.com"
  ],
  "good_token": "good",
  "cases": [
    {
      "name": "metadata",
      "why": "the document answers without a token",
      "method": "GET",
      "path": "/.well-known/oauth-protected-resource/mcp",
      "status": 200,
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Content-Type": "application/json"
      },
      "body": "{\"resource\":\"https://mcp.example.com/mcp\",\"authorization_servers\":[\"https://login.example.com\"],\"bearer_methods_supported\":[\"header\"]}"
    },
    {
      "name": "metadata-preflight",
      "why": "a browser client may fetch it cross-origin",
      "method": "OPTIONS",
      "path": "/.well-known/oauth-protected-resource/mcp",
      "status": 204,
      "headers": {
        "Access-Control-Allow-Origin": "*"
      }
    },
    {
      "name": "metadata-post",
      "why": "the document is read-only",
      "method": "POST",
      "path": "/.well-known/oauth-protected-resource/mcp",
      "status": 405,
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Allow": "GET, HEAD, OPTIONS",
        "Content-Type": "application/json"
      },
      "body": "{\"status\":405,\"code\":\"method_not_allowed\",\"message\":\"POST is not allowed on the protected resource metadata\"}\n"
    },
    {
      "name": "no-token",
      "why": "401 names the document in resource_metadata",
      "method": "POST",
      "path": "/mcp",
      "status": 401,
      "headers": {
        "Content-Type": "application/json",
        "WWW-Authenticate": "Bearer resource_metadata=\"https://mcp.example.com/.well-known/oauth-protected-resource/mcp\""
      },
      "body": "{\"status\":401,\"code\":\"unauthenticated\",\"message\":\"invalid token\"}\n"
    },
    {
      "name": "bad-token",
      "why": "a refused token is answered the same way",
      "method": "POST",
      "path": "/mcp",
      "authorization": "Bearer bad",
      "status": 401,
      "headers": {
        "Content-Type": "application/json",
        "WWW-Authenticate": "Bearer resource_metadata=\"https://mcp.example.com/.well-known/oauth-protected-resource/mcp\""
      },
      "body": "{\"status\":401,\"code\":\"unauthenticated\",\"message\":\"invalid token\"}\n"
    }
  ]
}
