#!/bin/sh
set -e

# --- Never let a KILLED gate look like a passing one ---
# The failure this guards against: the remote closes the connection while the
# hook is still working, the signal lands on a child, and a wrapper (make, a
# test runner) turns it into a normal exit. Control then falls through to the
# tail of this script, which prints "All checks passed", writes the success
# cache, and exits 0 — while the ref never reached the remote. Anything
# scripted on `git push` reads that as success.
#
# Trapping the termination signals makes the interrupted case explicit and
# non-zero. 128+signo is the conventional encoding, matching what the shell
# would have reported had the signal hit this process directly.
_gate_interrupted() {
    printf '\nPre-push: gate INTERRUPTED by SIG%s — checks did NOT complete.\n' "$1" >&2
    printf 'The push is being aborted; nothing was verified.\n' >&2
    # A killed run must never leave the "already verified this SHA" marker
    # behind, or the next push skips every check.
    [ -n "${CACHE_FILE:-}" ] && rm -f "$CACHE_FILE"
    exit "$2"
}
trap '_gate_interrupted HUP 129' HUP
trap '_gate_interrupted INT 130' INT
trap '_gate_interrupted PIPE 141' PIPE
trap '_gate_interrupted TERM 143' TERM

# The traps above cover the case where the signal reaches THIS process. They
# do not cover the other half: a signal that lands only on a child, which a
# wrapper then reports as an ordinary non-zero exit (`make: *** [target]
# Terminated: 15`). `set -e` aborts on that — but only for a command in a
# plain position. Two shapes in this script escape it, and both used to end
# with the script reaching its success tail:
#
#   cmd || true                  - status discarded outright
#   [ -n "$X" ] && { ...; }      - a compound whose left test is false
#
# So success is asserted explicitly instead of inferred from falling off the
# end: every exit path that should mean "verified" sets GATE_OK, and the EXIT
# trap refuses to report success without it.
GATE_OK=""
_gate_exit() {
    _status=$?
    # A non-zero status already speaks for itself; only the "fell through
    # with status 0 but never finished" case needs correcting.
    if [ "$_status" -eq 0 ] && [ -z "$GATE_OK" ]; then
        printf '\nPre-push: gate exited without completing its checks.\n' >&2
        printf 'Refusing to report success. Re-run the push.\n' >&2
        [ -n "${CACHE_FILE:-}" ] && rm -f "$CACHE_FILE"
        exit 1
    fi
    exit "$_status"
}
trap _gate_exit EXIT

ZERO_SHA="0000000000000000000000000000000000000000"

# Capture stdin once; pre-push receives ref info on stdin and we consult it
# in several places below.
#
# Git writes one "<local ref> <local sha> <remote ref> <remote sha>" line per
# ref and then closes the stream, so a plain `cat` normally terminates. But a
# push with nothing to send (a deletion, or an already-up-to-date ref) yields
# ZERO lines, and an invoker that hands the hook an inherited stdin it never
# closes leaves `cat` blocking on a stream that will never reach EOF — the
# push then wedges with no output at all.
#
# Guard the FIRST read only. `read -t` is a bash/ksh extension (dash exits 2
# on the unknown option) and `timeout` is absent from a stock macOS, so probe
# for -t support at runtime and degrade to an unguarded read where it is
# missing. Once a first line arrives, drain the rest with a plain blocking
# read: git emits the whole list in one burst, so only the initial wait can
# stall. That keeps a slow-but-real push intact — the timeout can never fire
# mid-list and truncate refs, because it is armed exclusively before the
# first line and disarmed the moment one is seen.
PUSH_INPUT=""
# shellcheck disable=SC3045 # Deliberate probe: rc 2 means -t is unsupported.
if read -t 0 _probe </dev/null 2>/dev/null || [ $? -ne 2 ]; then
    # shellcheck disable=SC3045 # -t guarded by the probe above.
    if IFS= read -r -t "${PRE_PUSH_STDIN_TIMEOUT:-10}" _line; then
        PUSH_INPUT="$_line"
        while IFS= read -r _line; do
            PUSH_INPUT="$PUSH_INPUT
$_line"
        done
    fi
else
    PUSH_INPUT=$(cat)
fi

# --- Nothing to push, or only deletions: no content to check ---
# A deletion line carries the zero SHA as its LOCAL sha ($2); its remote sha
# ($4) is the live commit being removed, so letting it reach the diff below
# would lint the entire branch just to drop a ref. Exit before any base
# resolution. Gate on there being no NON-deletion line rather than on a
# deletion being present, so a push mixing a deletion with a real ref still
# runs every check for the real ref.
NON_DELETIONS=$(printf '%s\n' "$PUSH_INPUT" | awk -v zero="$ZERO_SHA" '
    NF == 0 { next }
    $2 == zero { next }
    { print; exit }
')
if [ -z "$NON_DELETIONS" ]; then
    echo "Pre-push: nothing to check (branch deletion or empty ref list)."
    GATE_OK=1
    exit 0
fi

# --- Refuse direct pushes to protected branches (main/master) ---
# Bypass: git push --no-verify (use only for hotfixes you've consciously chosen)
PROTECTED_REFS="refs/heads/main refs/heads/master"
PROTECTED_HIT=$(printf '%s\n' "$PUSH_INPUT" | awk -v zero="$ZERO_SHA" '
    NF == 0 { next }
    $2 == zero { next }   # branch deletion: allow
    $3 == "refs/heads/main" || $3 == "refs/heads/master" { print $3; exit }
')
if [ -n "$PROTECTED_HIT" ]; then
    printf 'ERROR: refusing direct push to %s. Open a PR instead.\n' "$PROTECTED_HIT" >&2
    printf 'If this push is intentional (hotfix), bypass with: git push --no-verify\n' >&2
    exit 1
fi

# Skip if HEAD hasn't changed since last successful push
CACHE_FILE="$(git rev-parse --git-dir)/pre-push-last-sha"
CURRENT_SHA=$(git rev-parse HEAD)
if [ -f "$CACHE_FILE" ] && [ "$(cat "$CACHE_FILE")" = "$CURRENT_SHA" ]; then
    echo "Pre-push: HEAD unchanged since last push, skipping checks."
    GATE_OK=1
    exit 0
fi

# Determine which files changed vs the remote branch being pushed to.
# $1 is the remote name git invoked the hook with (e.g. "origin").
REMOTE_NAME="${1:-origin}"
REMOTE_SHA=$(printf '%s\n' "$PUSH_INPUT" | awk 'NF >= 4 {sha=$4} END {print sha}')

# Resolve a branch name to the commit published on the target remote.
resolve_remote_ref() {
    git rev-parse --verify --quiet "refs/remotes/$REMOTE_NAME/$1^{commit}" || return 1
}

# Resolve a branch name to a commit, preferring the remote-tracking ref
# (what is actually published) over a possibly-stale local branch.
resolve_ref() {
    resolve_remote_ref "$1" \
        || git rev-parse --verify --quiet "refs/heads/$1^{commit}" \
        || return 1
}

# Nearest merge-base wins: among candidate bases, keep the one that is a
# descendant of the others. Comparing against a base far up the history
# (e.g. `main` while the trunk for PRs is `next`) inflates the changed set
# with every commit the trunk gained meanwhile.
nearest_base() {
    head_sha=$(git rev-parse HEAD)
    best=""
    for cand in "$@"; do
        [ -n "$cand" ] || continue
        base=$(git merge-base HEAD "$cand" 2>/dev/null) || continue
        # A base equal to HEAD yields an empty diff and would skip every
        # check; treat it as unusable rather than a "very near" base.
        [ "$base" = "$head_sha" ] && continue
        if [ -z "$best" ] || git merge-base --is-ancestor "$best" "$base" 2>/dev/null; then
            best="$base"
        fi
    done
    [ -n "$best" ] || return 1
    printf '%s\n' "$best"
}

# New branch or force push: no usable remote SHA on stdin. Fall back to the
# nearest merge-base among the push destination and the long-lived branches.
if [ -z "$REMOTE_SHA" ] || [ "$REMOTE_SHA" = "$ZERO_SHA" ]; then
    CANDIDATES=""
    # The destination branch git is pushing to is better information than a
    # guess; usable only once that branch exists ON THE REMOTE. Never fall
    # back to the local branch of the same name — for a new branch that is
    # HEAD itself, whose merge-base is HEAD, silently emptying the diff.
    DEST_REF=$(printf '%s\n' "$PUSH_INPUT" | awk 'NF >= 3 { ref=$3 } END { print ref }')
    case "$DEST_REF" in
        refs/heads/*)
            DEST_SHA=$(resolve_remote_ref "${DEST_REF#refs/heads/}" || true)
            [ -n "$DEST_SHA" ] && CANDIDATES="$CANDIDATES $DEST_SHA"
            ;;
    esac
    for b in next main master; do
        SHA=$(resolve_ref "$b" || true)
        [ -n "$SHA" ] && CANDIDATES="$CANDIDATES $SHA"
    done
    # shellcheck disable=SC2086 # CANDIDATES is a deliberate word list.
    REMOTE_SHA=$(nearest_base $CANDIDATES 2>/dev/null || echo HEAD~1)
fi

CHANGED=$(git diff --name-only "$REMOTE_SHA" HEAD 2>/dev/null || git diff --name-only HEAD~1 HEAD)

# --- Detect affected areas ---
HAS_GO=$(echo "$CHANGED" | grep -E '\.go$' || true)
HAS_TS=$(echo "$CHANGED" | grep -E '^sdk/ts/' || true)
HAS_PY=$(echo "$CHANGED" | grep -E '^sdk/py/' || true)
HAS_DOCS=$(echo "$CHANGED" | grep -E '\.md$' || true)
HAS_CONFIG=$(echo "$CHANGED" | grep -E '(^|/)(\.github/|.*\.json|.*\.ya?ml)$' || true)
HAS_SDK_LAYOUT=$(echo "$CHANGED" | grep -E '^sdk/' || true)

# --- Activate the repo's pinned toolchain ---
# Without this the hook lints with whatever `go` the caller's PATH happens to
# resolve. A shell that never activated mise (a GUI git client, a `git push`
# from an editor, a fresh terminal) gets the system Go, and the pinned
# golangci-lint then fails to read its export data — surfacing as typecheck
# errors in files the push never touched. Declaring the pin in mise.toml is
# not enough; the gate has to actually run under it.
#
# Degrade, do not fail, when mise is absent: not every contributor uses it,
# and `make check-go-version` gives a precise diagnosis a moment later if the
# PATH toolchain is in fact wrong. This only removes the guesswork for the
# people who DO have the pin available.
if [ -z "${KIT_SKIP_MISE:-}" ] && command -v mise >/dev/null 2>&1; then
    # Resolve Go SPECIFICALLY rather than via `mise env`. `mise env` is
    # all-or-nothing: it exits non-zero and emits nothing if ANY tool in
    # mise.toml fails to resolve. A GitHub rate limit while looking up the
    # `rust` version list — observed, and entirely unrelated to Go — was
    # enough to silently drop the Go pin and let the hook lint with the
    # system toolchain, which is the exact failure this activation exists to
    # prevent. Asking only for what the linters need keeps the pin working
    # when an unrelated entry is unavailable.
    MISE_GO_ROOT=$(mise where go 2>/dev/null || true)
    if [ -n "$MISE_GO_ROOT" ] && [ -x "$MISE_GO_ROOT/bin/go" ]; then
        PATH="$MISE_GO_ROOT/bin:$PATH"
        export PATH
        GOROOT="$MISE_GO_ROOT"
        export GOROOT
        echo "Pre-push: Go activated from mise.toml ($(go version 2>/dev/null))."
    else
        # `mise where` also fails on an untrusted config — the state every
        # fresh clone of this repo starts in. Name the fix; the hook is the
        # first place most people will meet it.
        echo "Pre-push: mise present but Go is not resolvable from mise.toml." >&2
        echo "          run: mise trust && mise install" >&2
        echo "          continuing with the toolchain already on PATH." >&2
    fi
elif [ -z "${KIT_SKIP_MISE:-}" ]; then
    echo "Pre-push: mise not installed; using the toolchain on PATH."
    echo "          the repo pins Go in mise.toml — 'make check-go-version' verifies it."
fi

# --- Lint affected areas only ---
# Cross-cutting config/link/sdk-paths linters always run; per-language
# linters gate on whether their language's files changed in this push.
echo "Running affected linters..."

if [ -n "$HAS_GO" ]; then
    echo "  lint-go..."
    make lint-go
fi
if [ -n "$HAS_TS" ]; then
    echo "  lint-ts..."
    make lint-ts
fi
if [ -n "$HAS_PY" ]; then
    echo "  lint-py..."
    make lint-py
fi
if [ -n "$HAS_DOCS" ]; then
    echo "  lint-docs..."
    make lint-docs
fi
if [ -n "$HAS_CONFIG" ] || [ -n "$HAS_SDK_LAYOUT" ]; then
    echo "  lint-config..."
    make lint-config
fi
if [ -n "$HAS_DOCS" ] || [ -n "$HAS_CONFIG" ]; then
    echo "  lint-links..."
    make lint-links
fi
if [ -n "$HAS_SDK_LAYOUT" ] || [ -n "$HAS_CONFIG" ]; then
    echo "  lint-sdk-paths..."
    make lint-sdk-paths
fi

# --- Tests do NOT run here ---
# They used to. `make test-go`/`test-ts`/`test-py`/`test-parity` take many
# minutes, and GitHub's SSH server closes the connection well before that
# finishes: the push died with "Connection to github.com closed by remote
# host" and a terminated suite. ServerAliveInterval is already set, so this
# is a real duration limit, not a keepalive gap.
#
# The consequence was worse than a slow push. People reached for
# --no-verify to get anything out at all, which skips the linters above as
# well — the gate stopped gating. Keeping pre-push to the checks it can
# actually finish is what keeps it running at all.
#
# The selection logic moved verbatim to scripts/test-affected.sh:
#
#   make test-affected     # same per-language selection, on demand
#   make check             # the full suite
#
# CI remains the enforcing gate for tests.
echo "Pre-push: linters only (tests run via 'make test-affected' / CI)."

echo "All checks passed."
echo "$CURRENT_SHA" > "$CACHE_FILE"
GATE_OK=1
