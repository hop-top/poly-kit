name: CI (Go)

on:
  push:
    branches: [main]
    # The workflow file + mise.toml are in the filter so toolchain and
    # workflow repairs verify themselves instead of waiting for the
    # next .go push.
    paths: ["**.go", "go.mod", "go.sum", "mise.toml", ".github/workflows/ci-go.yml"]
  pull_request:
    branches: [main]
    paths: ["**.go", "go.mod", "go.sum", "mise.toml", ".github/workflows/ci-go.yml"]

permissions:
  contents: read

jobs:
  lint:
    name: Lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0

      # >>> kit-managed: toolchain >>>
      - uses: jdx/mise-action@c37c93293d6b742fc901e1406b8f764f6fb19dac # v2.4.4
        with:
          install: true
          cache: true
      - run: mise run install
      # <<< kit-managed: toolchain <<<

      - name: golangci-lint
        run: mise exec -- golangci-lint run ./...

  test:
    name: Test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0

      # >>> kit-managed: toolchain >>>
      - uses: jdx/mise-action@c37c93293d6b742fc901e1406b8f764f6fb19dac # v2.4.4
        with:
          install: true
          cache: true
      - run: mise run install
      # <<< kit-managed: toolchain <<<

      - name: Run tests
        # -race requires cgo, but mise.toml pins CGO_ENABLED=0 for
        # static builds — and `mise exec` re-applies [env] over the
        # job/step env, silently clobbering a step-level override. The
        # env(1) wrapper AFTER mise exec is the only layer that wins.
        run: mise exec -- env CGO_ENABLED=1 go test -race -coverprofile=coverage.out ./...

      - name: Upload coverage
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
        with:
          name: coverage-go
          path: coverage.out

  build:
    name: Build
    runs-on: ubuntu-latest
    needs: [lint, test]
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0

      # >>> kit-managed: toolchain >>>
      - uses: jdx/mise-action@c37c93293d6b742fc901e1406b8f764f6fb19dac # v2.4.4
        with:
          install: true
          cache: true
      - run: mise run install
      # <<< kit-managed: toolchain <<<

      - name: Build
        run: mise exec -- go build -o {{.Name}} .
