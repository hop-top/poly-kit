{
  "name": "{{.Vendor}}/{{.Name}}",
  "description": "{{.Description}}",
  "type": "project",
  "license": "{{.License}}",
  "authors": [
    { "name": "{{.Author}}", "email": "{{.Email}}" }
  ],
  "bin": ["bin/{{.Name}}"],
  "require": {
    "php": "^8.4",
    "hop-top/kit": "^0.5.0-alpha.5",{{/* x-release-please-version */}}
    "symfony/console": "^7.4 || ^8.0"
  },
  "require-dev": {
    "infection/infection": "^0.35.8",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^13",
    "shipmonk/composer-dependency-analyser": "^1.8.4",
    "shipmonk/dead-code-detector": "^1.4.2",
    "tomasvotruba/cognitive-complexity": "^1.3.0"
  },
  "autoload": {
    "psr-4": {
      "{{.VendorNamespace}}\\{{.NameNamespace}}\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "{{.VendorNamespace}}\\{{.NameNamespace}}\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpstan analyse"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true,
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  }
}
