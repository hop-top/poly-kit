      "status": 200,
      "response": "{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":{\"_meta\":{\"io.modelcontextprotocol/serverInfo\":{\"name\":\"cmdsurface\",\"version\":\"0.0.0\"}},\"content\":[{\"text\":\"pong\\n\",\"type\":\"text\"}],\"isError\":false,\"resultType\":\"complete\"}}\n"
