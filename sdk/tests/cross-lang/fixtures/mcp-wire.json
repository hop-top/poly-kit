      "name": "legacy/meta-progress-token-on-tools-list",
      "era": "legacy",
      "why": "bare params._meta on a NON-initialize method: M3 must not fire",
      "request": "{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"progressToken\":\"p2\"}}}",
      "status": 200,
      "response": "{\"jsonrpc\":\"2.0\",\"id\":9,\"result\":{\"tools\":[{\"description\":\"Deploy\",\"inputSchema\":{\"properties\":{},\"type\":\"object\"},\"name\":\"deploy\"},{\"description\":\"Ping the server\",\"inputSchema\":{\"properties\":{},\"type\":\"object\"},\"name\":\"ping\"},{\"description\":\"Locked\",\"inputSchema\":{\"properties\":{},\"type\":\"object\"},\"name\":\"secret\"},{\"description\":\"Add a widget\",\"inputSchema\":{\"properties\":{\"count\":{\"description\":\"widget count\",\"type\":\"integer\"},\"force\":{\"description\":\"force flag\",\"type\":\"boolean\"},\"name\":{\"description\":\"widget name\",\"type\":\"string\"},\"tag\":{\"description\":\"tag list\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"name\"],\"type\":\"object\"},\"name\":\"widget.add\"},{\"description\":\"Delete a widget\",\"inputSchema\":{\"properties\":{},\"type\":\"object\"},\"name\":\"widget.delete\"}]}}\n"
    },
    {
      "name": "legacy/protocol-version-header-is-not-modern",
      "era": "legacy",
      "why": "MCP-Protocol-Version header alone must NOT route modern (predates 2026-07-28)",
      "headers": {
        "MCP-Protocol-Version": "2025-06-18"
      },
      "request": "{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"tools/list\"}",
      "status": 200,
      "response": "{\"jsonrpc\":\"2.0\",\"id\":8,\"result\":{\"tools\":[{\"description\":\"Deploy\",\"inputSchema\":{\"properties\":{},\"type\":\"object\"},\"name\":\"deploy\"},{\"description\":\"Ping the server\",\"inputSchema\":{\"properties\":{},\"type\":\"object\"},\"name\":\"ping\"},{\"description\":\"Locked\",\"inputSchema\":{\"properties\":{},\"type\":\"object\"},\"name\":\"secret\"},{\"description\":\"Add a widget\",\"inputSchema\":{\"properties\":{\"count\":{\"description\":\"widget count\",\"type\":\"integer\"},\"force\":{\"description\":\"force flag\",\"type\":\"boolean\"},\"name\":{\"description\":\"widget name\",\"type\":\"string\"},\"tag\":{\"description\":\"tag list\",\"items\":{\"type\":\"string\"},\"type\":\"array\"}},\"required\":[\"name\"],\"type\":\"object\"},\"name\":\"widget.add\"},{\"description\":\"Delete a widget\",\"inputSchema\":{\"properties\":{},\"type\":\"object\"},\"name\":\"widget.delete\"}]}}\n"
    },
    {
      "name": "modern/server-discover",
      "era": "modern",
      "why": "server/discover is a modern marker on its own (M4)",
      "headers": {
        "MCP-Protocol-Version": "2026-07-28",
        "Mcp-Method": "server/discover"
      },
      "request": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"server/discover\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/clientCapabilities\":{},\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\"}}}",
      "status": 200,
      "response": "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"_meta\":{\"io.modelcontextprotocol/serverInfo\":{\"name\":\"cmdsurface\",\"version\":\"0.0.0\"}},\"cacheScope\":\"private\",\"capabilities\":{\"tools\":{}},\"resultType\":\"complete\",\"supportedVersions\":[\"2026-07-28\"],\"ttlMs\":0}}\n"
    },
    {
      "name": "modern/tools-list",
      "era": "modern",
      "why": "cacheable list result carries ttlMs + cacheScope",
      "headers": {
        "MCP-Protocol-Version": "2026-07-28",
        "Mcp-Method": "tools/list"
      },
      "request": "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/list\",\"params\":{\"_meta\":{\"io.modelcontextprotocol/clientCapabilities\":{},\"io.modelcontextprotocol/protocolVersion\":\"2026-07-28\"}}}",
      "status": 200,
      "response": "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"_meta\":{\"io.modelcontextprotocol/serverInfo\":{\"name\":\"cmdsurface\",\"version\":\"0.0.0\"}},\"cacheScope\":\"private\",\"resultType\":\"complete\",\"tools\":[{\"description\":\"Deploy\",\"inputSchema\":{\"properties\":{},\"type\":\"object\"},\"name\":\"deploy\"},{\"description\":\"Ping the server\",\"inputSchema\":{\"properties\":{},\"type\":\"object\"},\"name\":\"ping\"},{\"description\":\"Locked\",\"inputSchema\":{\"properties\":{},\"type\":\"object\"},\"name\":\"secret\"},{\"description\":\"Add a widget\",\"inputSchema\":{\"properties\":{\"count\":{\"description\":\"widget count\",\"type\":\"integer\"},\"name\":{\"description\":\"widget name\",\"type\":\"string\"}},\"required\":[\"name\"],\"type\":\"object\"},\"name\":\"widget.add\"},{\"description\":\"Delete a widget\",\"inputSchema\":{\"properties\":{},\"type\":\"object\"},\"name\":\"widget.delete\"}],\"ttlMs\":0}}\n"
