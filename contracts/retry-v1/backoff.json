{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hop.top/kit/contracts/retry-v1/backoff.json",
  "version": "v1",
  "description": "Retry backoff policy (Go `RetryConfig.Backoff`) with jitter off. Durations are integer nanoseconds. A zero or absent `base_ns` means the 100ms default and a zero or absent `max_ns` the 30s default. The delay for attempt n (0-indexed) is min(base * 2^n, max); a product that overflows or is not positive is the cap. `jitter_bounds` pins full jitter: with jitter on, every delay lies in [0, the unjittered delay], both ends reachable. `max_attempts` pins when a failed attempt (0-indexed) is the last one: 0 is unlimited, otherwise attempt+1 >= max_attempts stops.",
  "defaults": {
    "base_ns": 100000000,
    "max_ns": 30000000000
  },
  "backoff": [
    { "name": "zero config attempt 0", "config": {}, "attempt": 0, "delay_ns": 100000000 },
    { "name": "zero config attempt 1", "config": {}, "attempt": 1, "delay_ns": 200000000 },
    { "name": "zero config attempt 2", "config": {}, "attempt": 2, "delay_ns": 400000000 },
    { "name": "zero config attempt 8 below cap", "config": {}, "attempt": 8, "delay_ns": 25600000000 },
    { "name": "zero config attempt 9 hits cap", "config": {}, "attempt": 9, "delay_ns": 30000000000 },
    { "name": "zero config attempt 100", "config": {}, "attempt": 100, "delay_ns": 30000000000 },
    { "name": "overflow: product exceeds int64", "config": {}, "attempt": 64, "delay_ns": 30000000000 },
    { "name": "overflow: float infinity", "config": {}, "attempt": 1100, "delay_ns": 30000000000 },
    { "name": "custom base and max", "config": { "base_ns": 10000000, "max_ns": 1000000000 }, "attempt": 3, "delay_ns": 80000000 },
    { "name": "custom cap reached", "config": { "base_ns": 10000000, "max_ns": 100000000 }, "attempt": 100, "delay_ns": 100000000 },
    { "name": "base above max is capped at attempt 0", "config": { "base_ns": 5000000000, "max_ns": 1000000000 }, "attempt": 0, "delay_ns": 1000000000 },
    { "name": "base 1ns", "config": { "base_ns": 1, "max_ns": 1000 }, "attempt": 9, "delay_ns": 512 },
    { "name": "base 1ns capped", "config": { "base_ns": 1, "max_ns": 1000 }, "attempt": 10, "delay_ns": 1000 },
    { "name": "explicit defaults equal zero config", "config": { "base_ns": 100000000, "max_ns": 30000000000 }, "attempt": 4, "delay_ns": 1600000000 }
  ],
  "jitter_bounds": [
    { "name": "default config attempt 0", "config": {}, "attempt": 0, "max_ns": 100000000 },
    { "name": "default config attempt 5", "config": {}, "attempt": 5, "max_ns": 3200000000 },
    { "name": "default config capped", "config": {}, "attempt": 100, "max_ns": 30000000000 },
    { "name": "tiny delay", "config": { "base_ns": 1, "max_ns": 1000 }, "attempt": 0, "max_ns": 1 }
  ],
  "max_attempts": [
    { "name": "unlimited never stops", "max_attempts": 0, "attempt": 1000000, "stop": false },
    { "name": "one attempt stops at once", "max_attempts": 1, "attempt": 0, "stop": true },
    { "name": "three: first failure retries", "max_attempts": 3, "attempt": 0, "stop": false },
    { "name": "three: second failure retries", "max_attempts": 3, "attempt": 1, "stop": false },
    { "name": "three: third failure stops", "max_attempts": 3, "attempt": 2, "stop": true }
  ]
}
