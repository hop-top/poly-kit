{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hop.top/kit/contracts/config-v1/edit.json",
  "version": "v1",
  "description": "`Set` / `SetValue` / `Unset` on one file: the values the file holds afterwards and the comments it keeps. `set` writes a !!str scalar; `set_value` writes a typed value ({kind, repr} for scalars, {seq}/{map}); `unset` removes the key and prunes mappings it leaves empty. Intermediate keys are created, a non-mapping in the way becomes a mapping. `want` is the whole written document decoded into `any` ({map: ...}; aliases resolve to their anchor's value, so an edit of an anchored node shows through its aliases); `keeps` are substrings (comments, anchors) the written file must still contain. Bytes are not compared: Go re-emits the document, ports may splice.",
  "cases": [
    {
      "name": "set new file",
      "original": "",
      "op": "set",
      "key": "name",
      "value": "alice",
      "ok": true,
      "want": {
        "map": {
          "name": {
            "kind": "string",
            "repr": "alice"
          }
        }
      }
    },
    {
      "name": "set quotes retyping text",
      "original": "name: a\n",
      "op": "set",
      "key": "t",
      "value": "0.9",
      "ok": true,
      "want": {
        "map": {
          "name": {
            "kind": "string",
            "repr": "a"
          },
          "t": {
            "kind": "string",
            "repr": "0.9"
          }
        }
      }
    },
    {
      "name": "set deep key",
      "original": "",
      "op": "set",
      "key": "a.b.c",
      "value": "deep",
      "ok": true,
      "want": {
        "map": {
          "a": {
            "map": {
              "b": {
                "map": {
                  "c": {
                    "kind": "string",
                    "repr": "deep"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "set overwrite keeps comments",
      "original": "# head\nname: alice # who\nport: 1\n",
      "op": "set",
      "key": "name",
      "value": "bob",
      "ok": true,
      "want": {
        "map": {
          "name": {
            "kind": "string",
            "repr": "bob"
          },
          "port": {
            "kind": "int",
            "repr": "1"
          }
        }
      },
      "keeps": [
        "# head",
        "# who"
      ]
    },
    {
      "name": "set appends after comments",
      "original": "# first\nalpha: one\n# second\nbeta: two\n",
      "op": "set",
      "key": "gamma",
      "value": "three",
      "ok": true,
      "want": {
        "map": {
          "alpha": {
            "kind": "string",
            "repr": "one"
          },
          "beta": {
            "kind": "string",
            "repr": "two"
          },
          "gamma": {
            "kind": "string",
            "repr": "three"
          }
        }
      },
      "keeps": [
        "# first",
        "# second"
      ]
    },
    {
      "name": "set_value float",
      "original": "threshold: \"0.5\" # knob\n",
      "op": "set_value",
      "key": "threshold",
      "value": {
        "kind": "float",
        "repr": "0.9"
      },
      "ok": true,
      "want": {
        "map": {
          "threshold": {
            "kind": "float",
            "repr": "0.9"
          }
        }
      },
      "keeps": [
        "# knob"
      ]
    },
    {
      "name": "set_value bool null int",
      "original": "",
      "op": "set_value",
      "key": "k",
      "value": {
        "kind": "bool",
        "repr": "true"
      },
      "ok": true,
      "want": {
        "map": {
          "k": {
            "kind": "bool",
            "repr": "true"
          }
        }
      }
    },
    {
      "name": "set_value string stays string",
      "original": "",
      "op": "set_value",
      "key": "k",
      "value": {
        "kind": "string",
        "repr": "0.9"
      },
      "ok": true,
      "want": {
        "map": {
          "k": {
            "kind": "string",
            "repr": "0.9"
          }
        }
      }
    },
    {
      "name": "set_value lookalike stays string",
      "original": "",
      "op": "set_value",
      "key": "k",
      "value": {
        "kind": "string",
        "repr": "yes"
      },
      "ok": true,
      "want": {
        "map": {
          "k": {
            "kind": "string",
            "repr": "yes"
          }
        }
      }
    },
    {
      "name": "set_value map over scalar",
      "original": "db: sqlite\nother: 1\n",
      "op": "set_value",
      "key": "db",
      "value": {
        "map": {
          "driver": {
            "kind": "string",
            "repr": "postgres"
          },
          "port": {
            "kind": "int",
            "repr": "5432"
          }
        }
      },
      "ok": true,
      "want": {
        "map": {
          "db": {
            "map": {
              "driver": {
                "kind": "string",
                "repr": "postgres"
              },
              "port": {
                "kind": "int",
                "repr": "5432"
              }
            }
          },
          "other": {
            "kind": "int",
            "repr": "1"
          }
        }
      }
    },
    {
      "name": "set_value list",
      "original": "",
      "op": "set_value",
      "key": "tags",
      "value": {
        "seq": [
          {
            "kind": "string",
            "repr": "a"
          },
          {
            "kind": "int",
            "repr": "1"
          }
        ]
      },
      "ok": true,
      "want": {
        "map": {
          "tags": {
            "seq": [
              {
                "kind": "string",
                "repr": "a"
              },
              {
                "kind": "int",
                "repr": "1"
              }
            ]
          }
        }
      }
    },
    {
      "name": "set through scalar makes mapping",
      "original": "a: 1\n",
      "op": "set",
      "key": "a.b",
      "value": "v",
      "ok": true,
      "want": {
        "map": {
          "a": {
            "map": {
              "b": {
                "kind": "string",
                "repr": "v"
              }
            }
          }
        }
      }
    },
    {
      "name": "set keeps anchor",
      "original": "base: &b 1\nother: *b\n",
      "op": "set_value",
      "key": "base",
      "value": {
        "kind": "int",
        "repr": "2"
      },
      "ok": true,
      "want": {
        "map": {
          "base": {
            "kind": "int",
            "repr": "2"
          },
          "other": {
            "kind": "int",
            "repr": "2"
          }
        }
      },
      "keeps": [
        "&b",
        "*b"
      ]
    },
    {
      "name": "set inside anchored map shows through alias",
      "original": "base: &b {x: 1}\nother: *b\n",
      "op": "set_value",
      "key": "base.y",
      "value": {
        "kind": "int",
        "repr": "2"
      },
      "ok": true,
      "want": {
        "map": {
          "base": {
            "map": {
              "x": {
                "kind": "int",
                "repr": "1"
              },
              "y": {
                "kind": "int",
                "repr": "2"
              }
            }
          },
          "other": {
            "map": {
              "x": {
                "kind": "int",
                "repr": "1"
              },
              "y": {
                "kind": "int",
                "repr": "2"
              }
            }
          }
        }
      },
      "keeps": [
        "&b",
        "*b"
      ]
    },
    {
      "name": "unset inside anchored map shows through alias",
      "original": "base: &b {x: 1, y: 2}\nother: *b\n",
      "op": "unset",
      "key": "base.x",
      "ok": true,
      "want": {
        "map": {
          "base": {
            "map": {
              "y": {
                "kind": "int",
                "repr": "2"
              }
            }
          },
          "other": {
            "map": {
              "y": {
                "kind": "int",
                "repr": "2"
              }
            }
          }
        }
      },
      "keeps": [
        "&b",
        "*b"
      ]
    },
    {
      "name": "set anchored list to scalar",
      "original": "a: &b [1, 2]\nc: *b\n",
      "op": "set",
      "key": "a",
      "value": "z",
      "ok": true,
      "want": {
        "map": {
          "a": {
            "kind": "string",
            "repr": "z"
          },
          "c": {
            "kind": "string",
            "repr": "z"
          }
        }
      },
      "keeps": [
        "&b",
        "*b"
      ]
    },
    {
      "name": "flow value with trailing comment",
      "original": "tags: [a, b] # c\nz: 1\n",
      "op": "set",
      "key": "tags",
      "value": "x",
      "ok": true,
      "want": {
        "map": {
          "tags": {
            "kind": "string",
            "repr": "x"
          },
          "z": {
            "kind": "int",
            "repr": "1"
          }
        }
      },
      "keeps": [
        "# c"
      ]
    },
    {
      "name": "multi-line string on key with comment",
      "original": "k: v # c\nz: 1\n",
      "op": "set",
      "key": "k",
      "value": "l1\nl2",
      "ok": true,
      "want": {
        "map": {
          "k": {
            "kind": "string",
            "repr": "l1\nl2"
          },
          "z": {
            "kind": "int",
            "repr": "1"
          }
        }
      },
      "keeps": [
        "# c"
      ]
    },
    {
      "name": "flow mapping empty value",
      "original": "m: {a: , b: 1}\n",
      "op": "set",
      "key": "m.a",
      "value": "x",
      "ok": true,
      "want": {
        "map": {
          "m": {
            "map": {
              "a": {
                "kind": "string",
                "repr": "x"
              },
              "b": {
                "kind": "int",
                "repr": "1"
              }
            }
          }
        }
      }
    },
    {
      "name": "unset keep-chomped block scalar",
      "original": "k: |+\n  x\n\n# c\nz: 1\n",
      "op": "unset",
      "key": "k",
      "ok": true,
      "want": {
        "map": {
          "z": {
            "kind": "int",
            "repr": "1"
          }
        }
      },
      "keeps": [
        "# c"
      ]
    },
    {
      "name": "set in CRLF file",
      "original": "a: 1\r\nb: 2\r\n",
      "op": "set",
      "key": "c",
      "value": "x",
      "ok": true,
      "want": {
        "map": {
          "a": {
            "kind": "int",
            "repr": "1"
          },
          "b": {
            "kind": "int",
            "repr": "2"
          },
          "c": {
            "kind": "string",
            "repr": "x"
          }
        }
      }
    },
    {
      "name": "unset last key leaves an empty mapping",
      "original": "only: 1\n",
      "op": "unset",
      "key": "only",
      "ok": true,
      "want": {
        "map": {}
      }
    },
    {
      "name": "set nested into existing",
      "original": "core:\n  x: 1\n",
      "op": "set_value",
      "key": "core.y",
      "value": {
        "kind": "int",
        "repr": "2"
      },
      "ok": true,
      "want": {
        "map": {
          "core": {
            "map": {
              "x": {
                "kind": "int",
                "repr": "1"
              },
              "y": {
                "kind": "int",
                "repr": "2"
              }
            }
          }
        }
      }
    },
    {
      "name": "set into flow mapping",
      "original": "m: {a: 1}\n",
      "op": "set_value",
      "key": "m.b",
      "value": {
        "kind": "int",
        "repr": "2"
      },
      "ok": true,
      "want": {
        "map": {
          "m": {
            "map": {
              "a": {
                "kind": "int",
                "repr": "1"
              },
              "b": {
                "kind": "int",
                "repr": "2"
              }
            }
          }
        }
      }
    },
    {
      "name": "unset leaf",
      "original": "name: x # c\nport: 8080\n",
      "op": "unset",
      "key": "name",
      "ok": true,
      "want": {
        "map": {
          "port": {
            "kind": "int",
            "repr": "8080"
          }
        }
      }
    },
    {
      "name": "unset nested keeps sibling",
      "original": "core:\n  a: 1\n  b: 2\n",
      "op": "unset",
      "key": "core.a",
      "ok": true,
      "want": {
        "map": {
          "core": {
            "map": {
              "b": {
                "kind": "int",
                "repr": "2"
              }
            }
          }
        }
      }
    },
    {
      "name": "unset prunes empty parents",
      "original": "keep: 1\ncore:\n  mid:\n    only: v\n",
      "op": "unset",
      "key": "core.mid.only",
      "ok": true,
      "want": {
        "map": {
          "keep": {
            "kind": "int",
            "repr": "1"
          }
        }
      }
    },
    {
      "name": "unset missing key",
      "original": "a: 1\n",
      "op": "unset",
      "key": "zz",
      "ok": false,
      "error": "config unset: config: key not found"
    },
    {
      "name": "unset missing file",
      "original": "",
      "op": "unset",
      "key": "k",
      "ok": false,
      "error": "config unset: config: key not found"
    }
  ]
}
