{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hop.top/kit/contracts/config-v1/load.json",
  "version": "v1",
  "description": "`Load` into a fixed struct shape (name string, port int, ratio float, debug bool, tags []string, inner {a string, b int}, labels map[string]string, opt *string, extra any, all keyed by these lower-case names), starting from `start`, merging each YAML in `files` as an extra config file in order, then the `overrides` pairs. Merge rules are yaml.v3 decoding into an existing value: struct fields merge one by one; scalars, lists and each map entry are replaced; a null clears only the pointer, list and map fields and leaves scalars; unknown keys are ignored; `<<` merge keys expand with explicit keys winning. Each file is first decoded on its own as Go does: a duplicate key or a non-scalar key in a mapping the target reads fails, and decoding counts aliases with yaml.v3's budget (more than 100 aliased of more than 1000 decoded nodes, at a share above 0.99 up to 400k decoded, falling linearly to 0.10 at 4M, is `excessive aliasing`). Mappings under keys the target ignores are not decoded. A leading BOM, a tab after `:` and quoted-scalar continuation lines at column 0 read as libyaml reads them. `want` is the struct as JSON. `generate` ({prefix, line, count}) adds one more file after `files`: `prefix`, then `line` repeated `count` times with `{i}` replaced by 0..count-1 (large inputs without a large corpus). A failing case gives `error_contains` substrings; `<path>` stands for the failing file's path.",
  "cases": [
    {
      "name": "later file wins per field",
      "files": [
        "name: a\nport: 1\n",
        "name: b\n"
      ],
      "ok": true,
      "want": {
        "name": "b",
        "port": 1,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null,
        "extra": null
      }
    },
    {
      "name": "struct fields merge",
      "files": [
        "inner:\n  a: x\n  b: 1\n",
        "inner:\n  b: 2\n"
      ],
      "ok": true,
      "want": {
        "name": "",
        "port": 0,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "x",
          "b": 2
        },
        "labels": null,
        "opt": null,
        "extra": null
      }
    },
