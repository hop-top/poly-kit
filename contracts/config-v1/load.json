      "ok": true,
      "want": {
        "name": "",
        "port": 0,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": {
          "x": "1",
          "y": "3"
        },
        "opt": null,
        "extra": null
      }
    },
