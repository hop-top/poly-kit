{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hop.top/kit/contracts/config-v1/load.json",
  "version": "v1",
  "description": "`Load` into a fixed struct shape (name string, port int, ratio float, debug bool, tags []string, inner {a string, b int}, labels map[string]string, opt *string, all keyed by these lower-case names), starting from `start`, merging each YAML in `files` as an extra config file in order, then the `overrides` pairs. Merge rules are yaml.v3 decoding into an existing value: struct fields merge one by one; scalars, lists and each map entry are replaced; a null clears only the pointer, list and map fields and leaves scalars; unknown keys are ignored; `<<` merge keys expand with explicit keys winning. `want` is the struct as JSON. A failing case gives `error_contains` substrings; `<path>` stands for the failing file's path.",
  "cases": [
    {
      "name": "later file wins per field",
      "files": [
        "name: a\nport: 1\n",
        "name: b\n"
      ],
      "ok": true,
      "want": {
        "name": "b",
        "port": 1,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "struct fields merge",
      "files": [
        "inner:\n  a: x\n  b: 1\n",
        "inner:\n  b: 2\n"
      ],
      "ok": true,
      "want": {
        "name": "",
        "port": 0,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "x",
          "b": 2
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "lists replace",
      "files": [
        "tags: [a, b]\n",
        "tags: [c]\n"
      ],
      "ok": true,
      "want": {
        "name": "",
        "port": 0,
        "ratio": 0,
        "debug": false,
        "tags": [
          "c"
        ],
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "map entries replace, others kept",
      "files": [
        "labels: {x: '1', y: '2'}\n",
        "labels: {y: '3'}\n"
      ],
      "ok": true,
      "want": {
        "name": "",
        "port": 0,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": {
          "x": "1",
          "y": "3"
        },
        "opt": null
      }
    },
    {
      "name": "null leaves scalar",
      "files": [
        "name: a\n",
        "name: ~\n"
      ],
      "ok": true,
      "want": {
        "name": "a",
        "port": 0,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "null clears list map pointer",
      "files": [
        "tags: [a]\nlabels: {k: v}\nopt: o\n",
        "tags: ~\nlabels: ~\nopt: ~\n"
      ],
      "ok": true,
      "want": {
        "name": "",
        "port": 0,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "start survives",
      "files": [
        "port: 2\n"
      ],
      "start": {
        "name": "s",
        "port": 1,
        "ratio": 0,
        "debug": true,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      },
      "ok": true,
      "want": {
        "name": "s",
        "port": 2,
        "ratio": 0,
        "debug": true,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "scalar into string field",
      "files": [
        "name: 8080\n"
      ],
      "ok": true,
      "want": {
        "name": "8080",
        "port": 0,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "float into int truncates",
      "files": [
        "port: 1.9\n"
      ],
      "ok": true,
      "want": {
        "name": "",
        "port": 1,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "int into float",
      "files": [
        "ratio: 3\n"
      ],
      "ok": true,
      "want": {
        "name": "",
        "port": 0,
        "ratio": 3,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "yaml 1.1 bool into bool",
      "files": [
        "debug: yes\n"
      ],
      "ok": true,
      "want": {
        "name": "",
        "port": 0,
        "ratio": 0,
        "debug": true,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "unknown keys ignored",
      "files": [
        "nope: 1\nname: n\n"
      ],
      "ok": true,
      "want": {
        "name": "n",
        "port": 0,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "merge keys",
      "files": [
        "base: &b {name: m, port: 7}\n<<: *b\nport: 9\n"
      ],
      "ok": true,
      "want": {
        "name": "m",
        "port": 9,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "empty file is a no-op",
      "files": [
        "",
        "# only a comment\n"
      ],
      "start": {
        "name": "s",
        "port": 0,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      },
      "ok": true,
      "want": {
        "name": "s",
        "port": 0,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "overrides win",
      "files": [
        "name: file\n"
      ],
      "overrides": [
        "name=cli",
        "port=5"
      ],
      "ok": true,
      "want": {
        "name": "cli",
        "port": 5,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "",
          "b": 0
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "override nested field",
      "files": [
        "inner: {a: x, b: 1}\n"
      ],
      "overrides": [
        "inner.b=2"
      ],
      "ok": true,
      "want": {
        "name": "",
        "port": 0,
        "ratio": 0,
        "debug": false,
        "tags": null,
        "inner": {
          "a": "x",
          "b": 2
        },
        "labels": null,
        "opt": null
      }
    },
    {
      "name": "type error names the file",
      "files": [
        "port: abc\n"
      ],
      "ok": false,
      "error_contains": [
        "load config <path>: yaml: unmarshal errors:\n  line 1: cannot unmarshal !!str `abc` into int"
      ]
    },
    {
      "name": "syntax error names the file",
      "files": [
        "name: [unclosed\n"
      ],
      "ok": false,
      "error_contains": [
        "load config <path>: yaml: "
      ]
    },
    {
      "name": "override type error",
      "files": [],
      "overrides": [
        "port=abc"
      ],
      "ok": false,
      "error_contains": [
        "apply CLI overrides: apply overrides: yaml: unmarshal errors:\n  line 1: cannot unmarshal !!str `abc` into int"
      ]
    }
  ]
}
