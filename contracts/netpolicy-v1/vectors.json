{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hop.top/kit/contracts/netpolicy-v1/vectors.json",
  "version": "v1",
  "description": "Offline network policy (Go `netpolicy`). `is_loopback`: whether a host, with or without a port, names a loopback address; `localhost` is matched exactly, IPv4-mapped loopback counts, DNS names never do, and a portless bracketed host is loopback only when the brackets hold a loopback IPv6 address. `check_dial`: the dial decision under an offline or online policy; unix, unixgram and unixpacket are exempt; `error` is the exact refusal text, empty when the dial is permitted. `url_allows`: whether an offline policy lets a request to `url` through. `refusal`: the exact error text of an offline request refusal, naming method, scheme, host with port and path only.",
  "offline_message": "network disabled by --offline",
  "is_loopback": [
    { "name": "ipv4 loopback", "host": "127.0.0.1", "loopback": true },
    { "name": "ipv4 loopback with port", "host": "127.0.0.1:8080", "loopback": true },
    { "name": "ipv4 loopback range", "host": "127.1.2.3", "loopback": true },
    { "name": "ipv4 loopback empty port", "host": "127.0.0.1:", "loopback": true },
    { "name": "localhost", "host": "localhost", "loopback": true },
    { "name": "localhost with port", "host": "localhost:9000", "loopback": true },
    { "name": "ipv6 loopback", "host": "::1", "loopback": true },
    { "name": "ipv6 loopback long form", "host": "0:0:0:0:0:0:0:1", "loopback": true },
    { "name": "ipv6 loopback bracketed with port", "host": "[::1]:9000", "loopback": true },
    { "name": "ipv6 loopback bracketed without port", "host": "[::1]", "loopback": true },
    { "name": "ipv6 loopback long form bracketed without port", "host": "[0:0:0:0:0:0:0:1]", "loopback": true },
    { "name": "v4-mapped loopback", "host": "::ffff:127.0.0.1", "loopback": true },
    { "name": "v4-mapped loopback bracketed with port", "host": "[::ffff:127.0.0.1]:80", "loopback": true },
    { "name": "v4-mapped loopback bracketed without port", "host": "[::ffff:127.0.0.1]", "loopback": true },
    { "name": "ipv4 bracketed with port", "host": "[127.0.0.1]:80", "loopback": true },
    { "name": "localhost bracketed with port", "host": "[localhost]:80", "loopback": true },
    { "name": "ipv4 bracketed without port is not an address", "host": "[127.0.0.1]", "loopback": false },
    { "name": "localhost bracketed without port is not an address", "host": "[localhost]", "loopback": false },
    { "name": "non-loopback ipv6 bracketed", "host": "[2001:db8::1]", "loopback": false },
    { "name": "zoned ipv6 bracketed", "host": "[::1%lo0]", "loopback": false },
    { "name": "zoned ipv6 bracketed with port", "host": "[::1%lo0]:80", "loopback": false },
    { "name": "double brackets", "host": "[[::1]]", "loopback": false },
    { "name": "ipv4-compatible ipv6 is not loopback", "host": "::127.0.0.1", "loopback": false },
    { "name": "localhost upper case", "host": "LOCALHOST", "loopback": false },
    { "name": "localhost mixed case with port", "host": "Localhost:80", "loopback": false },
    { "name": "localhost trailing dot", "host": "localhost.", "loopback": false },
    { "name": "localhost suffix", "host": "localhost.evil.com", "loopback": false },
    { "name": "dns name", "host": "example.com", "loopback": false },
    { "name": "dns name with port", "host": "example.com:443", "loopback": false },
    { "name": "internal dns name", "host": "my-host.internal", "loopback": false },
    { "name": "public ipv4", "host": "8.8.8.8", "loopback": false },
    { "name": "private ipv4 with port", "host": "10.0.0.5:443", "loopback": false },
    { "name": "unspecified ipv4", "host": "0.0.0.0", "loopback": false },
    { "name": "unspecified ipv6", "host": "::", "loopback": false },
    { "name": "leading zeros", "host": "127.000.0.1", "loopback": false },
    { "name": "leading zero last octet", "host": "127.0.0.01", "loopback": false },
    { "name": "empty", "host": "", "loopback": false },
    { "name": "port only", "host": ":80", "loopback": false },
    { "name": "bare colons", "host": "1:2:3", "loopback": false }
  ],
  "check_dial": [
    { "name": "remote name refused", "offline": true, "network": "tcp", "addr": "db.example.com:3306", "error": "dial tcp db.example.com:3306: network disabled by --offline" },
    { "name": "remote ip refused", "offline": true, "network": "tcp", "addr": "10.0.0.5:443", "error": "dial tcp 10.0.0.5:443: network disabled by --offline" },
    { "name": "udp is network", "offline": true, "network": "udp", "addr": "8.8.8.8:53", "error": "dial udp 8.8.8.8:53: network disabled by --offline" },
    { "name": "bracketed ipv4 without port refused", "offline": true, "network": "tcp", "addr": "[127.0.0.1]", "error": "dial tcp [127.0.0.1]: network disabled by --offline" },
    { "name": "bracketed localhost without port refused", "offline": true, "network": "tcp", "addr": "[localhost]", "error": "dial tcp [localhost]: network disabled by --offline" },
    { "name": "unix upper case is network", "offline": true, "network": "UNIX", "addr": "example.com:1", "error": "dial UNIX example.com:1: network disabled by --offline" },
    { "name": "ipv4 loopback", "offline": true, "network": "tcp", "addr": "127.0.0.1:5432", "error": "" },
    { "name": "localhost", "offline": true, "network": "tcp", "addr": "localhost:25", "error": "" },
    { "name": "ipv6 loopback with port", "offline": true, "network": "tcp", "addr": "[::1]:9000", "error": "" },
    { "name": "ipv6 loopback bracketed without port", "offline": true, "network": "tcp", "addr": "[::1]", "error": "" },
    { "name": "unix socket", "offline": true, "network": "unix", "addr": "/tmp/kit.sock", "error": "" },
    { "name": "unixgram socket", "offline": true, "network": "unixgram", "addr": "/tmp/kit.sock", "error": "" },
    { "name": "unixpacket socket", "offline": true, "network": "unixpacket", "addr": "/tmp/kit.sock", "error": "" },
    { "name": "online permits remote", "offline": false, "network": "tcp", "addr": "db.example.com:3306", "error": "" },
    { "name": "online permits udp", "offline": false, "network": "udp", "addr": "8.8.8.8:53", "error": "" }
  ],
  "url_allows": [
    { "name": "ipv4 loopback", "url": "http://127.0.0.1:8080/health", "allowed": true },
    { "name": "localhost", "url": "http://localhost:9000/health", "allowed": true },
    { "name": "ipv6 loopback with port", "url": "http://[::1]:9000/health", "allowed": true },
    { "name": "ipv6 loopback without port", "url": "http://[::1]/health", "allowed": true },
    { "name": "ipv6 loopback explicit default port", "url": "http://[::1]:80/health", "allowed": true },
    { "name": "v4-mapped loopback without port", "url": "http://[::ffff:127.0.0.1]/health", "allowed": true },
    { "name": "external", "url": "https://example.invalid/v1/thing", "allowed": false },
    { "name": "dns name", "url": "http://my-host.internal/health", "allowed": false },
    { "name": "non-loopback ipv6", "url": "http://[2001:db8::1]/health", "allowed": false },
    { "name": "private ipv4", "url": "http://10.0.0.5:443/", "allowed": false }
  ],
  "refusal": [
    { "name": "credentials stripped", "method": "POST", "url": "https://alice:pw-secret@example.invalid/v1/models/m:generate?alt=sse&key=q-secret#frag-secret", "error": "POST https://example.invalid/v1/models/m:generate: network disabled by --offline" },
    { "name": "port kept", "method": "GET", "url": "http://u:p@example.invalid:8443/x?key=q-secret", "error": "GET http://example.invalid:8443/x: network disabled by --offline" },
    { "name": "dns name", "method": "GET", "url": "http://my-host.internal/health", "error": "GET http://my-host.internal/health: network disabled by --offline" }
  ]
}
