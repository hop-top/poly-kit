{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hop.top/kit/contracts/netpolicy-v1/vectors.json",
  "version": "v1",
  "description": "Offline network policy (Go `netpolicy`). `is_loopback`: whether a host, with or without a port, names a loopback address; `localhost` is matched exactly, IPv4-mapped loopback counts, DNS names never do, and a portless bracketed host is loopback only when the brackets hold a loopback IPv6 address. `check_dial`: the dial decision under an offline or online policy; unix, unixgram and unixpacket are exempt; `error` is the exact refusal text, empty when the dial is permitted. `url_allows`: whether an offline policy lets a request to `url` through. `refusal`: the exact error text of an offline request refusal, naming method, scheme, host with port and path only. `allow_message`: the sentinel text a host-allowlist refusal ends with. `host_allowed`: whether a host, with or without a port, passes the allowlist `allow_hosts` (exact entries and `*.suffix` entries; the suffix form matches one or more labels below the suffix, never the suffix itself and never an IP literal; hosts and entries are compared lower case, without a trailing dot, with IDNA names in ASCII form; loopback always passes; an entry that is not a valid host or `*.` suffix never matches). `allow_check_dial` and `allow_url`: the exact refusal of a dial or request under `allow_hosts`, empty when permitted. `redirect_message`, `redirect_headers`: the guarded HTTP client follows a redirect hop to another origin (another scheme, host or port) only when the original request carries nothing but Accept, Accept-Encoding, Accept-Language, User-Agent and Content-Type; with any other header (Authorization, Proxy-Authorization, Cookie, X-Api-Key, a custom one) the hop is refused before anything reaches the second origin, with a typed error whose text ends with `redirect_message`. Same-origin hops forward every header. A case sets `headers` on the request, redirects to the same or another origin per `cross_origin`, and says whether the hop was `refused`; an unrefused hop delivers every header unchanged, except that Content-Type, allowed across origins, may be dropped by the HTTP library on a bodiless hop and is not asserted.",
  "offline_message": "network disabled by --offline",
  "is_loopback": [
    { "name": "ipv4 loopback", "host": "127.0.0.1", "loopback": true },
    { "name": "ipv4 loopback with port", "host": "127.0.0.1:8080", "loopback": true },
    { "name": "ipv4 loopback range", "host": "127.1.2.3", "loopback": true },
    { "name": "ipv4 loopback empty port", "host": "127.0.0.1:", "loopback": true },
    { "name": "localhost", "host": "localhost", "loopback": true },
    { "name": "localhost with port", "host": "localhost:9000", "loopback": true },
    { "name": "ipv6 loopback", "host": "::1", "loopback": true },
    { "name": "ipv6 loopback long form", "host": "0:0:0:0:0:0:0:1", "loopback": true },
    { "name": "ipv6 loopback bracketed with port", "host": "[::1]:9000", "loopback": true },
    { "name": "ipv6 loopback bracketed without port", "host": "[::1]", "loopback": true },
    { "name": "ipv6 loopback long form bracketed without port", "host": "[0:0:0:0:0:0:0:1]", "loopback": true },
    { "name": "v4-mapped loopback", "host": "::ffff:127.0.0.1", "loopback": true },
    { "name": "v4-mapped loopback bracketed with port", "host": "[::ffff:127.0.0.1]:80", "loopback": true },
    { "name": "v4-mapped loopback bracketed without port", "host": "[::ffff:127.0.0.1]", "loopback": true },
    { "name": "ipv4 bracketed with port", "host": "[127.0.0.1]:80", "loopback": true },
    { "name": "localhost bracketed with port", "host": "[localhost]:80", "loopback": true },
    { "name": "ipv4 bracketed without port is not an address", "host": "[127.0.0.1]", "loopback": false },
    { "name": "localhost bracketed without port is not an address", "host": "[localhost]", "loopback": false },
    { "name": "non-loopback ipv6 bracketed", "host": "[2001:db8::1]", "loopback": false },
    { "name": "zoned ipv6 bracketed", "host": "[::1%lo0]", "loopback": false },
    { "name": "zoned ipv6 bracketed with port", "host": "[::1%lo0]:80", "loopback": false },
    { "name": "double brackets", "host": "[[::1]]", "loopback": false },
    { "name": "ipv4-compatible ipv6 is not loopback", "host": "::127.0.0.1", "loopback": false },
    { "name": "localhost upper case", "host": "LOCALHOST", "loopback": false },
    { "name": "localhost mixed case with port", "host": "Localhost:80", "loopback": false },
    { "name": "localhost trailing dot", "host": "localhost.", "loopback": false },
    { "name": "localhost suffix", "host": "localhost.evil.com", "loopback": false },
    { "name": "dns name", "host": "example.com", "loopback": false },
    { "name": "dns name with port", "host": "example.com:443", "loopback": false },
    { "name": "internal dns name", "host": "my-host.internal", "loopback": false },
    { "name": "public ipv4", "host": "8.8.8.8", "loopback": false },
    { "name": "private ipv4 with port", "host": "10.0.0.5:443", "loopback": false },
    { "name": "unspecified ipv4", "host": "0.0.0.0", "loopback": false },
    { "name": "unspecified ipv6", "host": "::", "loopback": false },
    { "name": "leading zeros", "host": "127.000.0.1", "loopback": false },
    { "name": "leading zero last octet", "host": "127.0.0.01", "loopback": false },
    { "name": "empty", "host": "", "loopback": false },
    { "name": "port only", "host": ":80", "loopback": false },
    { "name": "bare colons", "host": "1:2:3", "loopback": false }
  ],
  "check_dial": [
    { "name": "remote name refused", "offline": true, "network": "tcp", "addr": "db.example.com:3306", "error": "dial tcp db.example.com:3306: network disabled by --offline" },
    { "name": "remote ip refused", "offline": true, "network": "tcp", "addr": "10.0.0.5:443", "error": "dial tcp 10.0.0.5:443: network disabled by --offline" },
    { "name": "udp is network", "offline": true, "network": "udp", "addr": "8.8.8.8:53", "error": "dial udp 8.8.8.8:53: network disabled by --offline" },
    { "name": "bracketed ipv4 without port refused", "offline": true, "network": "tcp", "addr": "[127.0.0.1]", "error": "dial tcp [127.0.0.1]: network disabled by --offline" },
    { "name": "bracketed localhost without port refused", "offline": true, "network": "tcp", "addr": "[localhost]", "error": "dial tcp [localhost]: network disabled by --offline" },
    { "name": "unix upper case is network", "offline": true, "network": "UNIX", "addr": "example.com:1", "error": "dial UNIX example.com:1: network disabled by --offline" },
    { "name": "ipv4 loopback", "offline": true, "network": "tcp", "addr": "127.0.0.1:5432", "error": "" },
    { "name": "localhost", "offline": true, "network": "tcp", "addr": "localhost:25", "error": "" },
    { "name": "ipv6 loopback with port", "offline": true, "network": "tcp", "addr": "[::1]:9000", "error": "" },
    { "name": "ipv6 loopback bracketed without port", "offline": true, "network": "tcp", "addr": "[::1]", "error": "" },
    { "name": "unix socket", "offline": true, "network": "unix", "addr": "/tmp/kit.sock", "error": "" },
    { "name": "unixgram socket", "offline": true, "network": "unixgram", "addr": "/tmp/kit.sock", "error": "" },
    { "name": "unixpacket socket", "offline": true, "network": "unixpacket", "addr": "/tmp/kit.sock", "error": "" },
    { "name": "online permits remote", "offline": false, "network": "tcp", "addr": "db.example.com:3306", "error": "" },
    { "name": "online permits udp", "offline": false, "network": "udp", "addr": "8.8.8.8:53", "error": "" }
  ],
  "url_allows": [
    { "name": "ipv4 loopback", "url": "http://127.0.0.1:8080/health", "allowed": true },
    { "name": "localhost", "url": "http://localhost:9000/health", "allowed": true },
    { "name": "ipv6 loopback with port", "url": "http://[::1]:9000/health", "allowed": true },
    { "name": "ipv6 loopback without port", "url": "http://[::1]/health", "allowed": true },
    { "name": "ipv6 loopback explicit default port", "url": "http://[::1]:80/health", "allowed": true },
    { "name": "v4-mapped loopback without port", "url": "http://[::ffff:127.0.0.1]/health", "allowed": true },
    { "name": "external", "url": "https://example.invalid/v1/thing", "allowed": false },
    { "name": "dns name", "url": "http://my-host.internal/health", "allowed": false },
    { "name": "non-loopback ipv6", "url": "http://[2001:db8::1]/health", "allowed": false },
    { "name": "private ipv4", "url": "http://10.0.0.5:443/", "allowed": false }
  ],
  "refusal": [
    { "name": "credentials stripped", "method": "POST", "url": "https://alice:pw-secret@example.invalid/v1/models/m:generate?alt=sse&key=q-secret#frag-secret", "error": "POST https://example.invalid/v1/models/m:generate: network disabled by --offline" },
    { "name": "port kept", "method": "GET", "url": "http://u:p@example.invalid:8443/x?key=q-secret", "error": "GET http://example.invalid:8443/x: network disabled by --offline" },
    { "name": "dns name", "method": "GET", "url": "http://my-host.internal/health", "error": "GET http://my-host.internal/health: network disabled by --offline" }
  ],
  "allow_message": "host not allowed by netpolicy.allow_hosts",
  "host_allowed": [
    { "name": "exact match", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "host": "graph.microsoft.com", "allowed": true },
    { "name": "exact match with port", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "host": "graph.microsoft.com:443", "allowed": true },
    { "name": "exact match upper case", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "host": "Graph.Microsoft.COM", "allowed": true },
    { "name": "exact match trailing dot", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "host": "graph.microsoft.com.", "allowed": true },
    { "name": "exact match trailing dot with port", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "host": "graph.microsoft.com.:443", "allowed": true },
    { "name": "entry upper case with trailing dot", "allow_hosts": ["Graph.Microsoft.COM."], "host": "graph.microsoft.com", "allowed": true },
    { "name": "unlisted host", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "host": "evil.example.com", "allowed": false },
    { "name": "subdomain of an exact entry is not allowed", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "host": "x.graph.microsoft.com", "allowed": false },
    { "name": "suffix of an exact entry is not allowed", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "host": "microsoft.com", "allowed": false },
    { "name": "prefix lookalike", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "host": "graph.microsoft.com.evil.example", "allowed": false },
    { "name": "suffix entry matches one label", "allow_hosts": ["*.example.com"], "host": "api.example.com", "allowed": true },
    { "name": "suffix entry matches several labels", "allow_hosts": ["*.example.com"], "host": "a.b.example.com", "allowed": true },
    { "name": "suffix entry with port", "allow_hosts": ["*.example.com"], "host": "api.example.com:8443", "allowed": true },
    { "name": "suffix entry does not match the apex", "allow_hosts": ["*.example.com"], "host": "example.com", "allowed": false },
    { "name": "suffix entry needs a label boundary", "allow_hosts": ["*.example.com"], "host": "evilexample.com", "allowed": false },
    { "name": "suffix entry does not match a longer tld", "allow_hosts": ["*.example.com"], "host": "api.example.com.evil.example", "allowed": false },
    { "name": "suffix entry upper case", "allow_hosts": ["*.Example.COM"], "host": "API.example.com", "allowed": true },
    { "name": "suffix entry never matches an ip literal", "allow_hosts": ["*.0.0.1"], "host": "10.0.0.1", "allowed": false },
    { "name": "ip entry is exact", "allow_hosts": ["203.0.113.5"], "host": "203.0.113.5", "allowed": true },
    { "name": "ip entry other address", "allow_hosts": ["203.0.113.5"], "host": "203.0.113.6", "allowed": false },
    { "name": "ip entry with port", "allow_hosts": ["203.0.113.5"], "host": "203.0.113.5:80", "allowed": true },
    { "name": "ipv6 entry bracketed", "allow_hosts": ["[2001:db8::1]"], "host": "[2001:db8::1]:443", "allowed": true },
    { "name": "ipv6 entry matches long form", "allow_hosts": ["2001:db8::1"], "host": "2001:db8:0:0:0:0:0:1", "allowed": true },
    { "name": "idna entry matches ascii form", "allow_hosts": ["bücher.example"], "host": "xn--bcher-kva.example", "allowed": true },
    { "name": "idna host matches ascii entry", "allow_hosts": ["xn--bcher-kva.example"], "host": "bücher.example", "allowed": true },
    { "name": "idna suffix entry", "allow_hosts": ["*.bücher.example"], "host": "shop.xn--bcher-kva.example", "allowed": true },
    { "name": "loopback ip always passes", "allow_hosts": ["graph.microsoft.com"], "host": "127.0.0.1:8080", "allowed": true },
    { "name": "localhost always passes", "allow_hosts": ["graph.microsoft.com"], "host": "localhost", "allowed": true },
    { "name": "ipv6 loopback always passes", "allow_hosts": ["graph.microsoft.com"], "host": "[::1]:9000", "allowed": true },
    { "name": "empty entry list allows everything", "allow_hosts": [], "host": "evil.example.com", "allowed": true },
    { "name": "bare star never matches", "allow_hosts": ["*"], "host": "example.com", "allowed": false },
    { "name": "star suffix without suffix never matches", "allow_hosts": ["*."], "host": "example.com", "allowed": false },
    { "name": "inner wildcard never matches", "allow_hosts": ["a*.example.com"], "host": "abc.example.com", "allowed": false },
    { "name": "double wildcard never matches", "allow_hosts": ["*.*.example.com"], "host": "a.b.example.com", "allowed": false },
    { "name": "entry with a path never matches", "allow_hosts": ["example.com/x"], "host": "example.com", "allowed": false },
    { "name": "empty entry never matches", "allow_hosts": [""], "host": "example.com", "allowed": false },
    { "name": "empty host never matches", "allow_hosts": ["example.com"], "host": "", "allowed": false }
  ],
  "allow_check_dial": [
    { "name": "listed host", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "network": "tcp", "addr": "graph.microsoft.com:443", "error": "" },
    { "name": "unlisted host", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "network": "tcp", "addr": "evil.example.com:443", "error": "dial tcp evil.example.com:443: host not allowed by netpolicy.allow_hosts" },
    { "name": "unlisted udp", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "network": "udp", "addr": "8.8.8.8:53", "error": "dial udp 8.8.8.8:53: host not allowed by netpolicy.allow_hosts" },
    { "name": "suffix entry", "allow_hosts": ["*.example.com"], "network": "tcp", "addr": "a.example.com:25", "error": "" },
    { "name": "suffix entry apex refused", "allow_hosts": ["*.example.com"], "network": "tcp", "addr": "example.com:25", "error": "dial tcp example.com:25: host not allowed by netpolicy.allow_hosts" },
    { "name": "loopback exempt", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "network": "tcp", "addr": "127.0.0.1:5432", "error": "" },
    { "name": "unix socket exempt", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "network": "unix", "addr": "/tmp/x.sock", "error": "" }
  ],
  "allow_url": [
    { "name": "listed host", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "method": "GET", "url": "https://graph.microsoft.com/v1.0/me", "error": "" },
    { "name": "listed host with port", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "method": "GET", "url": "https://login.microsoftonline.com:443/token", "error": "" },
    { "name": "unlisted host refusal omits query and userinfo", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "method": "GET", "url": "https://alice:pw@evil.example.com:8443/v1/x?key=k#f", "error": "GET https://evil.example.com:8443/v1/x: host not allowed by netpolicy.allow_hosts" },
    { "name": "suffix entry", "allow_hosts": ["*.pipedrive.com"], "method": "GET", "url": "https://acme.pipedrive.com/api/v1/deals", "error": "" },
    { "name": "loopback exempt", "allow_hosts": ["graph.microsoft.com", "login.microsoftonline.com", "api.pipedrive.com"], "method": "GET", "url": "http://127.0.0.1:8080/health", "error": "" }
  ],
  "redirect_message": "request carries headers that may not leave their origin",
  "redirect_headers": [
    { "name": "same origin keeps every header", "cross_origin": false, "headers": { "Authorization": "Bearer s", "X-Api-Key": "k", "Cookie": "a=b", "Accept": "application/json" }, "refused": false },
    { "name": "cross origin, allowlisted headers only", "cross_origin": true, "headers": { "Accept": "application/json", "Accept-Encoding": "identity", "Accept-Language": "en", "User-Agent": "kit-test", "Content-Type": "application/json" }, "refused": false },
    { "name": "cross origin, no headers", "cross_origin": true, "headers": {}, "refused": false },
    { "name": "cross origin, Authorization", "cross_origin": true, "headers": { "Authorization": "Bearer s" }, "refused": true },
    { "name": "cross origin, Proxy-Authorization", "cross_origin": true, "headers": { "Proxy-Authorization": "Basic czpz" }, "refused": true },
    { "name": "cross origin, Cookie", "cross_origin": true, "headers": { "Cookie": "session=secret-cookie" }, "refused": true },
    { "name": "cross origin, X-Api-Key", "cross_origin": true, "headers": { "X-Api-Key": "k" }, "refused": true },
    { "name": "cross origin, custom header", "cross_origin": true, "headers": { "X-Internal-Trace": "trace-secret-1" }, "refused": true },
    { "name": "cross origin, allowlisted plus one custom", "cross_origin": true, "headers": { "Accept": "application/json", "User-Agent": "kit-test", "X-Tenant": "acme" }, "refused": true }
  ]
}
