{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hop.top/kit/contracts/completion-v1/completers.json",
  "version": "v1",
  "description": "Completer outputs (Go `console/cli/completion`). Each case builds `completer` from a one-key spec: `static` (items), `static_values` (values), `func` (returns `items` or fails with `error`, ignoring the prefix), `prefixed` (`dimension` over an inner spec), `config_keys` (the dotted leaf keys of `config`, lowercased), `file` (extensions) or `dir`. `items` is what Complete returns for `prefix`; `error: true` means Complete fails. `resolved` is the shell bridge: `completions` are the values with any description joined by a tab, `directive` is the cobra shell directive integer (0 default, 1 error, 4 no file completion, 8 filter by extension, 16 directories only). `unordered: true` compares as sets.",
  "cases": [
    { "name": "static empty prefix returns every item",
      "completer": { "static": [ { "value": "leo", "description": "Low Earth Orbit" }, { "value": "geo", "description": "Geostationary" }, { "value": "lunar", "description": "Trans-lunar" } ] },
      "prefix": "",
      "items": [ { "value": "leo", "description": "Low Earth Orbit" }, { "value": "geo", "description": "Geostationary" }, { "value": "lunar", "description": "Trans-lunar" } ],
      "resolved": { "completions": [ "leo\tLow Earth Orbit", "geo\tGeostationary", "lunar\tTrans-lunar" ], "directive": 4 } },
    { "name": "static prefix keeps order",
      "completer": { "static": [ { "value": "leo", "description": "Low Earth Orbit" }, { "value": "geo", "description": "Geostationary" }, { "value": "lunar", "description": "Trans-lunar" } ] },
      "prefix": "l",
      "items": [ { "value": "leo", "description": "Low Earth Orbit" }, { "value": "lunar", "description": "Trans-lunar" } ],
      "resolved": { "completions": [ "leo\tLow Earth Orbit", "lunar\tTrans-lunar" ], "directive": 4 } },
    { "name": "static prefix is case-insensitive",
      "completer": { "static": [ { "value": "LEO", "description": "Low Earth Orbit" }, { "value": "GEO", "description": "Geostationary" } ] },
      "prefix": "le",
      "items": [ { "value": "LEO", "description": "Low Earth Orbit" } ],
      "resolved": { "completions": [ "LEO\tLow Earth Orbit" ], "directive": 4 } },
    { "name": "static uppercase prefix matches lowercase value",
      "completer": { "static_values": [ "prod", "preview", "staging" ] },
      "prefix": "PR",
      "items": [ { "value": "prod" }, { "value": "preview" } ],
      "resolved": { "completions": [ "prod", "preview" ], "directive": 4 } },
    { "name": "static no match is empty with no file completion",
      "completer": { "static_values": [ "alpha", "beta" ] },
      "prefix": "z",
      "items": [],
      "resolved": { "completions": [], "directive": 4 } },
    { "name": "static values carry no description",
      "completer": { "static_values": [ "alpha", "beta", "gamma" ] },
      "prefix": "b",
      "items": [ { "value": "beta" } ],
      "resolved": { "completions": [ "beta" ], "directive": 4 } },
    { "name": "static prefix longer than value does not match",
      "completer": { "static_values": [ "go" ] },
      "prefix": "gopher",
      "items": [],
      "resolved": { "completions": [], "directive": 4 } },
    { "name": "static keeps duplicates",
      "completer": { "static_values": [ "a", "a" ] },
      "prefix": "",
      "items": [ { "value": "a" }, { "value": "a" } ],
      "resolved": { "completions": [ "a", "a" ], "directive": 4 } },
    { "name": "func does not filter by prefix",
      "completer": { "func": { "items": [ { "value": "result" }, { "value": "other", "description": "kept" } ] } },
      "prefix": "test-prefix",
      "items": [ { "value": "result" }, { "value": "other", "description": "kept" } ],
      "resolved": { "completions": [ "result", "other\tkept" ], "directive": 4 } },
    { "name": "func error resolves to the error directive",
      "completer": { "func": { "error": "backend down" } },
      "prefix": "",
      "error": true,
      "resolved": { "completions": [], "directive": 1 } },
    { "name": "prefixed empty prefix suggests the dimension",
      "completer": { "prefixed": { "dimension": "priority", "values": { "static_values": [ "high", "low" ] } } },
      "prefix": "",
      "items": [ { "value": "priority:", "description": "priority values" } ],
      "resolved": { "completions": [ "priority:\tpriority values" ], "directive": 4 } },
    { "name": "prefixed partial dimension is case-insensitive",
      "completer": { "prefixed": { "dimension": "priority", "values": { "static_values": [ "high", "low" ] } } },
      "prefix": "PRI",
      "items": [ { "value": "priority:", "description": "priority values" } ],
      "resolved": { "completions": [ "priority:\tpriority values" ], "directive": 4 } },
    { "name": "prefixed non-matching dimension prefix is empty",
      "completer": { "prefixed": { "dimension": "priority", "values": { "static_values": [ "high", "low" ] } } },
      "prefix": "x",
      "items": [],
      "resolved": { "completions": [], "directive": 4 } },
    { "name": "prefixed completes values after the colon",
      "completer": { "prefixed": { "dimension": "priority", "values": { "static_values": [ "high", "low" ] } } },
      "prefix": "priority:h",
      "items": [ { "value": "priority:high" } ],
      "resolved": { "completions": [ "priority:high" ], "directive": 4 } },
    { "name": "prefixed colon with empty value returns every value",
      "completer": { "prefixed": { "dimension": "env", "values": { "static_values": [ "prod", "preview", "staging" ] } } },
      "prefix": "env:",
      "items": [ { "value": "env:prod" }, { "value": "env:preview" }, { "value": "env:staging" } ],
      "resolved": { "completions": [ "env:prod", "env:preview", "env:staging" ], "directive": 4 } },
    { "name": "prefixed dimension before colon matches case-insensitively and re-prepends the declared case",
      "completer": { "prefixed": { "dimension": "env", "values": { "static_values": [ "prod", "preview", "staging" ] } } },
      "prefix": "ENV:pr",
      "items": [ { "value": "env:prod" }, { "value": "env:preview" } ],
      "resolved": { "completions": [ "env:prod", "env:preview" ], "directive": 4 } },
    { "name": "prefixed wrong dimension is empty",
      "completer": { "prefixed": { "dimension": "priority", "values": { "static_values": [ "high", "low" ] } } },
      "prefix": "other:",
      "items": [],
      "resolved": { "completions": [], "directive": 4 } },
    { "name": "prefixed splits on the first colon only",
      "completer": { "prefixed": { "dimension": "k", "values": { "static_values": [ "a:b", "a:c", "b" ] } } },
      "prefix": "k:a:",
      "items": [ { "value": "k:a:b" }, { "value": "k:a:c" } ],
      "resolved": { "completions": [ "k:a:b", "k:a:c" ], "directive": 4 } },
    { "name": "prefixed keeps inner descriptions",
      "completer": { "prefixed": { "dimension": "orbit", "values": { "static": [ { "value": "leo", "description": "Low Earth Orbit" } ] } } },
      "prefix": "orbit:",
      "items": [ { "value": "orbit:leo", "description": "Low Earth Orbit" } ],
      "resolved": { "completions": [ "orbit:leo\tLow Earth Orbit" ], "directive": 4 } },
    { "name": "prefixed propagates the inner error",
      "completer": { "prefixed": { "dimension": "env", "values": { "func": { "error": "lookup failed" } } } },
      "prefix": "env:",
      "error": true,
      "resolved": { "completions": [], "directive": 1 } },
    { "name": "prefixed without colon does not consult the inner completer",
      "completer": { "prefixed": { "dimension": "env", "values": { "func": { "error": "must not run" } } } },
      "prefix": "e",
      "items": [ { "value": "env:", "description": "env values" } ],
      "resolved": { "completions": [ "env:\tenv values" ], "directive": 4 } },
    { "name": "config keys filter by prefix",
      "completer": { "config_keys": { "log": { "level": "info", "format": "json" }, "server": { "port": 8080 } } },
      "prefix": "log",
      "unordered": true,
      "items": [ { "value": "log.level" }, { "value": "log.format" } ],
      "resolved": { "completions": [ "log.level", "log.format" ], "directive": 4 } },
    { "name": "config keys empty prefix lists every leaf",
      "completer": { "config_keys": { "log": { "level": "info", "format": "json" }, "server": { "port": 8080 } } },
      "prefix": "",
      "unordered": true,
      "items": [ { "value": "log.level" }, { "value": "log.format" }, { "value": "server.port" } ],
      "resolved": { "completions": [ "log.level", "log.format", "server.port" ], "directive": 4 } },
    { "name": "config keys are lowercased and match case-insensitively",
      "completer": { "config_keys": { "Server": { "Port": 8080 }, "name": "x" } },
      "prefix": "SER",
      "unordered": true,
      "items": [ { "value": "server.port" } ],
      "resolved": { "completions": [ "server.port" ], "directive": 4 } },
    { "name": "file returns its extensions and filters by extension",
      "completer": { "file": [ ".yaml", ".yml" ] },
      "prefix": "ignored",
      "items": [ { "value": ".yaml" }, { "value": ".yml" } ],
      "resolved": { "completions": [ ".yaml", ".yml" ], "directive": 8 } },
    { "name": "file without extensions falls back to default completion",
      "completer": { "file": [] },
      "prefix": "",
      "items": [],
      "resolved": { "completions": [], "directive": 0 } },
    { "name": "dir completes directories only",
      "completer": { "dir": {} },
      "prefix": "src",
      "items": [],
      "resolved": { "completions": [], "directive": 16 } }
  ]
}
