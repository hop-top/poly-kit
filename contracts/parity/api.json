{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hop.top/kit/contracts/parity/api.json",
  "description": "Cross-language conformance record for the kit REST server (go/transport/api and the Go api service's middleware plane). Go is the authority. Tables: client_address, trusted_proxies, hosts, listener_hosts, origin, and openapi_cases (expected documents rendered by huma from a language-neutral model; regenerate with go test ./go/transport/api -run TestAPIContractOpenAPI -update-api-contract). `ports` records which behaviors each port has shipped; PENDING passes.",
  "version": 1,
  "constants": {
    "health": {
      "liveness": "/healthz",
      "readiness": "/readyz",
      "ok": "ok",
      "unavailable": "unavailable"
    },
    "topics": {
      "request.started": "kit.api.request.started",
      "request.ended": "kit.api.request.ended"
    },
    "event_source": "api.router",
    "default_max_body_bytes": 1048576,
    "request_id_header": "X-Request-ID",
    "default_csp": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'",
    "default_hsts_max_age_seconds": 31536000,
    "default_auth_challenge": "Bearer",
    "codes": {
      "host_rejected": 403,
      "origin_rejected": 403,
      "body_too_large": 413,
      "unauthenticated": 401,
      "rate_limited": 429,
      "method_not_allowed": 405
    }
  },
  "ports": {
    "go": {
      "implementation": "go/transport/api, mounted by go/console/cli/service",
      "request_id": "SHIPPED",
      "client_address": "SHIPPED",
      "access_log": "SHIPPED",
      "recovery": "SHIPPED",
      "security_headers": "SHIPPED",
      "health_routes": "SHIPPED",
      "host_check": "SHIPPED",
      "origin_check": "SHIPPED",
      "cors": "SHIPPED",
      "body_limit": "SHIPPED",
      "compression": "SHIPPED",
      "auth": "SHIPPED",
      "rate_limit": "SHIPPED",
      "bus_events": "SHIPPED",
      "openapi": "SHIPPED",
      "sse": "SHIPPED",
      "websocket": "SHIPPED",
      "service_lifecycle": "SHIPPED"
    },
    "rs": {
      "implementation": "sdk/experimental/rs/src/api_server, feature api-server",
      "request_id": "SHIPPED",
      "client_address": "SHIPPED",
      "access_log": "SHIPPED",
      "recovery": "SHIPPED",
      "security_headers": "SHIPPED",
      "health_routes": "SHIPPED",
      "host_check": "SHIPPED",
      "origin_check": "SHIPPED",
      "cors": "SHIPPED",
      "body_limit": "SHIPPED",
      "compression": "SHIPPED",
      "auth": "SHIPPED",
      "rate_limit": "SHIPPED",
      "bus_events": "SHIPPED",
      "openapi": "SHIPPED",
      "sse": "SHIPPED",
      "websocket": "PENDING",
      "service_lifecycle": "SHIPPED"
    },
    "ts": {
      "implementation": "none",
      "note": "no REST server port"
    },
    "py": {
      "implementation": "none",
      "note": "no REST server port"
    }
  },
  "client_address": [
    {
      "name": "no trusted proxies: spoofed headers ignored",
      "trusted": [],
      "peer": "203.0.113.9:5555",
      "headers": {
        "X-Forwarded-For": [
          "1.2.3.4"
        ],
        "Forwarded": [
          "for=1.2.3.4;proto=https"
        ],
        "X-Real-IP": [
          "1.2.3.4"
        ],
        "X-Forwarded-Proto": [
          "https"
        ]
      },
      "want": {
        "client": "203.0.113.9",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "untrusted peer: spoofed headers ignored",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "203.0.113.9:5555",
      "headers": {
        "X-Forwarded-For": [
          "1.2.3.4"
        ],
        "Forwarded": [
          "for=1.2.3.4;proto=https"
        ],
        "X-Real-IP": [
          "1.2.3.4"
        ],
        "X-Forwarded-Proto": [
          "https"
        ]
      },
      "want": {
        "client": "203.0.113.9",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "trusted peer, X-Forwarded-For",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Forwarded-For": [
          "198.51.100.7"
        ],
        "X-Forwarded-Proto": [
          "https"
        ]
      },
      "want": {
        "client": "198.51.100.7",
        "peer": "10.0.0.2:4321",
        "https": true
      }
    },
    {
      "name": "chain of trusted proxies stops at the first untrusted address",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Forwarded-For": [
          "6.6.6.6, 198.51.100.7, 10.1.1.1",
          "10.0.0.9"
        ]
      },
      "want": {
        "client": "198.51.100.7",
        "peer": "10.0.0.2:4321",
        "https": false
      }
    },
    {
      "name": "every hop trusted: the leftmost",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Forwarded-For": [
          "10.9.9.9, 10.1.1.1"
        ]
      },
      "want": {
        "client": "10.9.9.9",
        "peer": "10.0.0.2:4321",
        "https": false
      }
    },
    {
      "name": "client-supplied garbage left of the client is never read",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Forwarded-For": [
          "not-an-ip, 198.51.100.7"
        ]
      },
      "want": {
        "client": "198.51.100.7",
        "peer": "10.0.0.2:4321",
        "https": false
      }
    },
    {
      "name": "Forwarded, chain, quoted IPv6 with port",
      "trusted": [
        "10.0.0.0/8",
        "2001:db8:ffff::/48"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "Forwarded": [
          "for=192.0.2.60;proto=http, For=\"[2001:db8:cafe::17]:4711\";Proto=HTTPS;by=10.0.0.1",
          "for=\"[2001:db8:ffff::1]\""
        ]
      },
      "want": {
        "client": "2001:db8:cafe::17",
        "peer": "10.0.0.2:4321",
        "https": true
      }
    },
    {
      "name": "IPv6 peer and X-Forwarded-For",
      "trusted": [
        "2001:db8::/32"
      ],
      "peer": "[2001:db8::1]:443",
      "headers": {
        "X-Forwarded-For": [
          "2001:db8:1::5, 2a00:1450::1"
        ]
      },
      "want": {
        "client": "2a00:1450::1",
        "peer": "[2001:db8::1]:443",
        "https": false
      }
    },
    {
      "name": "IPv4-mapped peer matches an IPv4 network",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "[::ffff:10.0.0.2]:80",
      "headers": {
        "X-Forwarded-For": [
          "198.51.100.7:6000"
        ]
      },
      "want": {
        "client": "198.51.100.7",
        "peer": "[::ffff:10.0.0.2]:80",
        "https": false
      }
    },
    {
      "name": "single trusted address",
      "trusted": [
        "10.0.0.2"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Real-IP": [
          "198.51.100.7"
        ],
        "X-Forwarded-Proto": [
          "https"
        ]
      },
      "want": {
        "client": "198.51.100.7",
        "peer": "10.0.0.2:4321",
        "https": true
      }
    },
    {
      "name": "X-Real-IP loses to X-Forwarded-For",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Real-IP": [
          "6.6.6.6"
        ],
        "X-Forwarded-For": [
          "198.51.100.7"
        ]
      },
      "want": {
        "client": "198.51.100.7",
        "peer": "10.0.0.2:4321",
        "https": false
      }
    },
    {
      "name": "Forwarded and X-Forwarded-For disagree: neither believed",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "Forwarded": [
          "for=6.6.6.6;proto=https"
        ],
        "X-Forwarded-For": [
          "198.51.100.7"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "Forwarded and X-Forwarded-For agree",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "Forwarded": [
          "for=198.51.100.7"
        ],
        "X-Forwarded-For": [
          "198.51.100.7"
        ],
        "X-Forwarded-Proto": [
          "https"
        ]
      },
      "want": {
        "client": "198.51.100.7",
        "peer": "10.0.0.2:4321",
        "https": true
      }
    },
    {
      "name": "X-Forwarded-Proto aligned with the client's hop",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Forwarded-For": [
          "198.51.100.7, 10.1.1.1"
        ],
        "X-Forwarded-Proto": [
          "https, http"
        ]
      },
      "want": {
        "client": "198.51.100.7",
        "peer": "10.0.0.2:4321",
        "https": true
      }
    },
    {
      "name": "X-Forwarded-Proto that cannot be aligned is ignored",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Forwarded-For": [
          "198.51.100.7, 10.1.1.1, 10.1.1.2"
        ],
        "X-Forwarded-Proto": [
          "https, http"
        ]
      },
      "want": {
        "client": "198.51.100.7",
        "peer": "10.0.0.2:4321",
        "https": false
      }
    },
    {
      "name": "lone X-Forwarded-Proto from a trusted peer",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Forwarded-Proto": [
          "HTTPS"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": true
      }
    },
    {
      "name": "malformed: garbage X-Forwarded-For",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Forwarded-For": [
          "198.51.100.7, bogus"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "malformed: garbage past a trusted hop",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Forwarded-For": [
          "bogus, 10.1.1.1"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "malformed: unknown past a trusted hop",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "Forwarded": [
          "for=unknown, for=10.1.1.1"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "malformed: empty X-Forwarded-For entry",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Forwarded-For": [
          "198.51.100.7,"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "malformed: X-Forwarded-For hostname",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Forwarded-For": [
          "evil.example"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "malformed: Forwarded for=unknown",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "Forwarded": [
          "for=unknown"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "malformed: Forwarded obfuscated node",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "Forwarded": [
          "for=_hidden"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "malformed: Forwarded without for",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "Forwarded": [
          "proto=https;by=10.0.0.1"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "malformed: Forwarded repeated parameter",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "Forwarded": [
          "for=198.51.100.7;for=6.6.6.6"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "malformed: Forwarded unterminated quote",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "Forwarded": [
          "for=\"[2001:db8::1]"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "malformed: Forwarded bare IPv6 unquoted",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "Forwarded": [
          "for=2001:db8::1"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "malformed: Forwarded trailing junk",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "Forwarded": [
          "for=198.51.100.7 junk"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "malformed: two X-Real-IP values",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Real-IP": [
          "198.51.100.7",
          "6.6.6.6"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "malformed: X-Real-IP garbage",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "X-Real-IP": [
          "???"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    },
    {
      "name": "malformed: malformed Forwarded beside XFF",
      "trusted": [
        "10.0.0.0/8"
      ],
      "peer": "10.0.0.2:4321",
      "headers": {
        "Forwarded": [
          "for=bogus"
        ],
        "X-Forwarded-For": [
          "198.51.100.7"
        ]
      },
      "want": {
        "client": "10.0.0.2",
        "peer": "",
        "https": false
      }
    }
  ],
  "trusted_proxies": {
    "parse": {
      "input": [
        " 10.1.2.3/8 ",
        "",
        "192.0.2.1",
        "2001:db8::/32",
        "::1",
        "::ffff:172.16.0.0/108"
      ],
      "canonical": [
        "10.0.0.0/8",
        "192.0.2.1/32",
        "2001:db8::/32",
        "::1/128",
        "172.16.0.0/12"
      ]
    },
    "invalid": [
      "10.0.0.0/33",
      "proxy.internal",
      "10.0.0",
      "fe80::1%eth0"
    ]
  },
  "hosts": [
    {
      "name": "exact name, any port",
      "allow": [
        "example.test"
      ],
      "host": "example.test",
      "permitted": true
    },
    {
      "name": "exact name with port",
      "allow": [
        "example.test"
      ],
      "host": "example.test:8080",
      "permitted": true
    },
    {
      "name": "case and trailing dot",
      "allow": [
        "Example.Test"
      ],
      "host": "example.test.",
      "permitted": true
    },
    {
      "name": "host:port entry matches that port",
      "allow": [
        "example.test:8080"
      ],
      "host": "example.test:8080",
      "permitted": true
    },
    {
      "name": "host:port entry refuses another port",
      "allow": [
        "example.test:8080"
      ],
      "host": "example.test:9090",
      "permitted": false
    },
    {
      "name": "host:port entry refuses a bare name",
      "allow": [
        "example.test:8080"
      ],
      "host": "example.test",
      "permitted": false
    },
    {
      "name": "other name refused",
      "allow": [
        "example.test"
      ],
      "host": "evil.test",
      "permitted": false
    },
    {
      "name": "wildcard permits all",
      "allow": [
        "*"
      ],
      "host": "anything.test",
      "permitted": true
    },
    {
      "name": "empty Host is permitted",
      "allow": [
        "example.test"
      ],
      "host": "",
      "permitted": true
    },
    {
      "name": "IPv6 literal",
      "allow": [
        "::1"
      ],
      "host": "[::1]:80",
      "permitted": true
    },
    {
      "name": "IPv6 literal, canonical form",
      "allow": [
        "2001:db8::1"
      ],
      "host": "[2001:0db8:0:0:0:0:0:1]:80",
      "permitted": true
    },
    {
      "name": "IPv4-mapped IPv6 reads as IPv4",
      "allow": [
        "10.0.0.1"
      ],
      "host": "[::ffff:10.0.0.1]:80",
      "permitted": true
    },
    {
      "name": "empty allowlist refuses",
      "allow": [],
      "host": "example.test",
      "permitted": false
    }
  ],
  "listener_hosts": [
    {
      "addr": "127.0.0.1:8080",
