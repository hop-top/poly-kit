      "wildcard": false
    },
    {
      "addr": "Svc.Internal:80",
      "hosts": [
        "svc.internal"
      ],
      "wildcard": false
    }
  ],
  "origin": [
    {
      "name": "safe methods always pass",
      "allow": [],
      "method": "GET",
      "host": "a.test",
      "headers": {
        "Sec-Fetch-Site": "cross-site",
        "Origin": "https://evil.test"
      },
      "permitted": true,
      "message": ""
    },
    {
      "name": "HEAD passes",
      "allow": [],
      "method": "HEAD",
      "host": "a.test",
      "headers": {
        "Sec-Fetch-Site": "cross-site"
      },
      "permitted": true,
      "message": ""
    },
    {
      "name": "OPTIONS passes",
      "allow": [],
      "method": "OPTIONS",
      "host": "a.test",
      "headers": {
        "Origin": "https://evil.test"
      },
      "permitted": true,
      "message": ""
    },
    {
      "name": "same-origin fetch metadata",
      "allow": [],
      "method": "POST",
      "host": "a.test",
      "headers": {
        "Sec-Fetch-Site": "same-origin"
      },
      "permitted": true,
      "message": ""
    },
    {
      "name": "user-initiated navigation",
      "allow": [],
      "method": "POST",
      "host": "a.test",
      "headers": {
        "Sec-Fetch-Site": "none"
      },
      "permitted": true,
      "message": ""
    },
    {
      "name": "cross-site fetch metadata is refused",
      "allow": [],
      "method": "POST",
      "host": "a.test",
      "headers": {
        "Sec-Fetch-Site": "cross-site",
        "Origin": "https://evil.test"
      },
      "permitted": false,
      "message": "cross-origin request from \"https://evil.test\" refused"
    },
    {
      "name": "same-site fetch metadata is refused",
      "allow": [],
      "method": "DELETE",
      "host": "a.test",
      "headers": {
        "Sec-Fetch-Site": "same-site"
      },
      "permitted": false,
      "message": "cross-origin request from \"Sec-Fetch-Site: same-site\" refused"
    },
    {
      "name": "no browser headers: not a browser",
      "allow": [],
      "method": "POST",
      "host": "a.test",
      "headers": {},
      "permitted": true,
      "message": ""
    },
    {
      "name": "Origin matching Host passes",
      "allow": [],
      "method": "POST",
      "host": "a.test:8080",
      "headers": {
        "Origin": "http://a.test:8080"
      },
      "permitted": true,
      "message": ""
    },
    {
      "name": "Origin not matching Host is refused",
      "allow": [],
      "method": "POST",
      "host": "a.test",
      "headers": {
        "Origin": "https://evil.test"
      },
      "permitted": false,
      "message": "cross-origin request from \"https://evil.test\" refused"
    },
    {
      "name": "null Origin is refused",
      "allow": [],
      "method": "POST",
      "host": "a.test",
      "headers": {
        "Origin": "null"
      },
      "permitted": false,
      "message": "cross-origin request from \"null\" refused"
    },
    {
      "name": "trusted origin passes cross-site",
      "allow": [
        "https://app.test"
      ],
      "method": "POST",
      "host": "a.test",
      "headers": {
        "Sec-Fetch-Site": "cross-site",
        "Origin": "https://app.test"
      },
      "permitted": true,
      "message": ""
    },
    {
      "name": "trusted origin passes on Origin alone",
      "allow": [
        "https://app.test"
      ],
      "method": "POST",
      "host": "a.test",
      "headers": {
        "Origin": "https://app.test"
      },
      "permitted": true,
      "message": ""
    },
    {
      "name": "trusted origin is exact",
      "allow": [
        "https://app.test"
      ],
      "method": "POST",
      "host": "a.test",
      "headers": {
        "Origin": "https://app.test:8443"
      },
      "permitted": false,
      "message": "cross-origin request from \"https://app.test:8443\" refused"
    },
    {
      "name": "wildcard trusts every origin",
      "allow": [
        "*"
      ],
      "method": "POST",
      "host": "a.test",
      "headers": {
        "Sec-Fetch-Site": "cross-site",
        "Origin": "https://evil.test"
      },
      "permitted": true,
      "message": ""
    }
