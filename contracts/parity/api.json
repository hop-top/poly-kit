    {
      "addr": "0.0.0.0:80",
      "hosts": [],
      "wildcard": true
    },
    {
      "addr": "[::]:80",
      "hosts": [],
      "wildcard": true
    },
    {
      "addr": ":8080",
      "hosts": [],
      "wildcard": true
    },
    {
      "addr": "10.1.2.3:80",
      "hosts": [
