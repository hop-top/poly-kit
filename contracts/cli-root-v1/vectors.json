{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://hop.top/kit/contracts/cli-root-v1/vectors.json",
 "version": "v1",
 "description": "The kit CLI root, independent of language: persistent root flags, -v/--version, help groups and --help-all, root aliases, flag-error surfaces (USAGE envelope text, json and yaml), and opt-in flag autocorrect. Each case builds the named tree under a kit root, runs `args` with `env` set and pins the exit code and the stream contents. Runnable leaves echo what they were invoked with as one line of JSON (`path`, the leaf's own `flags` that were set, positional `args`, and the resolved `globals`), so the vectors pin parsing and resolution, not a leaf's behavior. Help is pinned by what it lists (`stdout_contains` / `stdout_omits`), never byte for byte: layout belongs to each port's renderer. `stderr_contains` entries are substrings of the text-format envelope; `stderr_json` keys are compared to the same-named keys of the structured envelope. The tree's `side_effect` is the `kit/side-effect` annotation; a flag's `enum` is its declared value set; a flag's `type` is bool, int or string (the default).",
 "trees": {
  "main": {
   "program": "kitapp",
   "version": "1.2.3",
   "about": "Kit app",
   "commands": [
    {
     "name": "deploy",
     "about": "Deploy a target",
     "side_effect": "write",
     "flags": [
      {
       "long": "env",
       "short": "e",
       "help": "Target env",
       "type": "string"
      },
      {
       "long": "mode",
       "help": "Mode",
       "type": "string",
       "enum": [
        "fast",
        "slow"
       ]
      },
      {
       "long": "count",
       "help": "Count",
       "type": "int"
      },
      {
       "long": "force",
       "help": "Skip checks",
       "type": "bool"
      }
     ]
    },
    {
     "name": "ls",
     "about": "List things",
     "side_effect": "read",
     "flags": [
      {
       "long": "limit",
       "help": "Max rows",
       "type": "int"
      },
      {
       "long": "kind",
       "help": "Kind",
       "type": "string"
      }
     ]
    },
    {
     "name": "router",
     "about": "Router ops",
     "commands": [
      {
       "name": "start",
       "about": "Start router",
       "side_effect": "write"
      }
     ]
    }
   ],
   "aliases": {
    "d": "deploy",
    "rs": "router start"
   }
  },
  "ops": {
   "program": "kitapp",
   "version": "1.2.3",
   "about": "Kit app",
   "policy": true,
   "chdir_resolver": {
    "shortname": "proj"
   },
   "project_marker": ".kit/config.yaml",
   "fixtures": {
    "proj/": "",
    "marker/.kit/config.yaml": "a: 1\n",
    "bare/": "",
    "base.yaml": "a: 1\n",
    "xdg/kitapp/policies/readonly.yaml": "name: readonly\nallow:\n  write: []\n  destructive: []\n",
    "xdg/kitapp/policies/nodel.yaml": "allow:\n  destructive: []\n",
    "xdg/kitapp/policies/confirm.yaml": "require_confirm:\n  - add\n",
    "xdg/kitapp/policies/broken.yaml": "allow: [\n"
   },
   "flag_validators": [
    {
     "flag": "level",
     "reject": [
      "bad"
     ],
     "code": "INVALID_LEVEL",
     "message": "level must not be bad",
     "exit": 2
    }
   ],
   "commands": [
    {
     "name": "ls",
     "about": "List",
     "side_effect": "read",
     "kind": "dryrun"
    },
    {
     "name": "add",
     "about": "Add",
     "side_effect": "write",
     "kind": "dryrun"
    },
    {
     "name": "rm",
     "about": "Remove",
     "side_effect": "destructive",
     "kind": "dryrun"
    },
    {
     "name": "purge",
     "about": "Purge",
     "side_effect": "destructive",
     "annotations": {
      "kit/destructive-token": "required"
     },
     "kind": "dryrun"
    },
    {
     "name": "shell",
     "about": "Shell",
     "side_effect": "interactive",
     "kind": "dryrun"
    },
    {
     "name": "sync",
     "about": "Sync",
     "side_effect": "write",
     "dry_run": "opted-out",
     "kind": "dryrun"
    },
    {
     "name": "import",
     "about": "Import",
     "side_effect": "write",
     "kind": "dryrun",
     "flags": [
      {
       "long": "policy",
       "help": "Policy file",
       "type": "string"
      }
     ]
    },
    {
     "name": "where",
     "about": "Cwd",
     "side_effect": "read",
     "kind": "pwd"
    },
    {
     "name": "cfg",
     "about": "Config args",
     "side_effect": "read",
     "kind": "config"
    },
    {
     "name": "tune",
     "about": "Tune",
     "side_effect": "read",
     "flags": [
      {
       "long": "level",
       "help": "Level",
       "type": "string"
      }
     ]
    }
   ]
  },
  "strict": {
   "program": "kitapp",
   "version": "1.2.3",
   "about": "Kit app",
   "validate": true,
   "commands": [
    {
     "name": "status",
     "about": "Status",
     "long": "Long status",
     "side_effect": "read",
     "annotations": {
      "kit/top-level-verb": "true",
      "kit/idempotent": "yes"
     }
    },
    {
     "name": "ls",
     "about": "Ls",
     "long": "Long ls",
     "side_effect": "read",
     "annotations": {
      "kit/top-level-verb": "true",
      "kit/idempotent": "yes"
     }
    }
   ]
  },
  "strict_bad": {
   "program": "kitapp",
   "version": "1.2.3",
   "about": "Kit app",
   "validate": true,
   "commands": [
    {
     "name": "status",
     "about": "Status",
     "long": "Long status",
     "side_effect": "read",
     "annotations": {
      "kit/top-level-verb": "true",
      "kit/idempotent": "yes"
     }
    },
    {
     "name": "nolong",
     "about": "No long",
     "side_effect": "read",
     "annotations": {
      "kit/top-level-verb": "true",
      "kit/idempotent": "yes"
     }
    },
    {
     "name": "plain",
     "about": "Plain",
     "long": "Plain long",
     "side_effect": "read"
    },
    {
     "name": "untagged",
     "about": "Untagged",
     "long": "Long",
     "annotations": {
      "kit/top-level-verb": "true"
     }
    },
    {
     "name": "bad",
     "about": "Bad",
     "long": "Long",
     "side_effect": "nope",
     "annotations": {
      "kit/top-level-verb": "true"
     }
    },
    {
     "name": "g",
     "about": "G",
     "commands": [
      {
       "name": "h",
       "about": "H",
       "commands": [
        {
         "name": "i",
         "about": "I",
         "long": "Long",
         "side_effect": "read"
        }
       ]
      }
     ]
    }
   ]
  },
  "sig": {
   "program": "kitapp",
   "version": "1.2.3",
   "about": "Kit app",
   "signature": "reject",
   "commands": [
    {
     "name": "shadow",
     "about": "Shadow",
     "side_effect": "read",
     "flags": [
      {
       "long": "quiet",
       "help": "Mine",
       "type": "bool"
      }
     ]
    },
    {
     "name": "hold",
     "about": "Hold",
     "side_effect": "read",
     "annotations": {
      "kit/reserves-children": "taken"
     },
     "commands": [
      {
       "name": "taken",
       "about": "Taken",
       "side_effect": "read"
      }
     ]
    }
   ]
  },
  "sig_ok": {
   "program": "kitapp",
   "version": "1.2.3",
   "about": "Kit app",
   "signature": "reject",
   "commands": [
    {
     "name": "ls",
     "about": "List",
     "side_effect": "read",
     "kind": "pwd",
     "annotations": {
      "kit/passthrough": "true"
     }
    }
   ]
  },
  "store": {
   "program": "kitapp",
   "version": "1.2.3",
   "about": "Kit app",
   "alias_store": "aliases.yaml",
   "fixtures": {
    "aliases.yaml": "ll: ls\n"
   },
   "commands": [
    {
     "name": "ls",
     "about": "List",
     "side_effect": "read"
    }
   ]
  },
  "cfgcmd": {
   "program": "kitapp",
   "version": "1.2.3",
   "about": "Kit app",
   "config_chain": [
    {
     "path": "{tmp}/nowhere/config.yaml",
     "source": "cwd",
     "scope": "local"
    },
    {
     "path": "{tmp}/base.yaml",
     "source": "user",
     "scope": "user"
    },
    {
     "path": "{tmp}/system.yaml",
     "source": "system",
     "scope": "system"
    }
   ],
   "fixtures": {
    "base.yaml": "a: 1\n"
   },
   "commands": [
    {
     "name": "ls",
     "about": "List",
     "side_effect": "read"
    }
   ]
  },
  "cfgnone": {
   "program": "kitapp",
   "version": "1.2.3",
   "about": "Kit app",
   "config_chain": [
    {
     "path": "{tmp}/nowhere/config.yaml",
     "source": "cwd",
     "scope": "local"
    }
   ],
   "commands": [
    {
     "name": "ls",
     "about": "List",
     "side_effect": "read"
    }
   ]
  }
 },
 "cases": [
  {
   "name": "defaults",
   "tree": "main",
   "args": [
    "deploy"
   ],
   "exit": 0,
   "stdout": "{\"args\":[],\"flags\":{},\"globals\":{\"format\":\"table\",\"no-color\":\"false\",\"no-hints\":\"false\",\"offline\":\"false\",\"quiet\":\"false\",\"verbose\":0},\"path\":\"deploy\"}\n"
  },
  {
   "name": "persistent flags parse on a leaf",
   "tree": "main",
   "args": [
    "deploy",
    "prod",
    "--quiet",
    "-VV",
    "--format",
    "json",
    "--no-color",
    "--offline",
    "--no-hints",
    "-e",
    "x",
    "--count",
    "3"
   ],
   "exit": 0,
   "stdout": "{\"args\":[\"prod\"],\"flags\":{\"count\":\"3\",\"env\":\"x\"},\"globals\":{\"format\":\"json\",\"no-color\":\"true\",\"no-hints\":\"true\",\"offline\":\"true\",\"quiet\":\"true\",\"verbose\":2},\"path\":\"deploy\"}\n"
  },
  {
   "name": "flags before the command",
   "tree": "main",
   "args": [
    "--quiet",
    "-V",
    "deploy"
   ],
   "exit": 0,
   "stdout": "{\"args\":[],\"flags\":{},\"globals\":{\"format\":\"table\",\"no-color\":\"false\",\"no-hints\":\"false\",\"offline\":\"false\",\"quiet\":\"true\",\"verbose\":1},\"path\":\"deploy\"}\n"
  },
  {
   "name": "version long",
   "tree": "main",
   "args": [
    "--version"
   ],
   "exit": 0,
   "stdout": "kitapp v1.2.3\n"
  },
  {
   "name": "version short",
   "tree": "main",
   "args": [
    "-v"
   ],
   "exit": 0,
   "stdout": "kitapp v1.2.3\n"
  },
  {
   "name": "end of options",
   "tree": "main",
   "args": [
    "deploy",
    "--",
    "--force"
   ],
   "exit": 0,
   "stdout": "{\"args\":[\"--force\"],\"flags\":{},\"globals\":{\"format\":\"table\",\"no-color\":\"false\",\"no-hints\":\"false\",\"offline\":\"false\",\"quiet\":\"false\",\"verbose\":0},\"path\":\"deploy\"}\n"
  },
  {
   "name": "unknown flag",
   "tree": "main",
   "args": [
    "deploy",
    "--nosuch"
   ],
   "exit": 2,
   "stderr_contains": [
    "USAGE: unknown flag --nosuch",
    "Cause: no flag named --nosuch on kitapp deploy",
    "Fix: run 'kitapp deploy --help' for usage"
   ]
  },
  {
   "name": "near flag suggests the fix",
   "tree": "main",
   "args": [
    "deploy",
    "--evn",
    "prod"
   ],
   "exit": 2,
   "stderr_contains": [
    "USAGE: unknown flag --evn",
    "Cause: no flag named --evn on kitapp deploy",
    "Fix: --env"
   ]
  },
  {
   "name": "missing value names the type",
   "tree": "main",
   "args": [
    "deploy",
    "--env"
   ],
   "exit": 2,
   "stderr_contains": [
    "USAGE: missing value for --env",
    "Cause: --env requires a value: Target env",
    "Fix: --env <string>"
   ]
  },
  {
   "name": "missing enum value lists alternatives",
   "tree": "main",
   "args": [
    "deploy",
    "--mode"
   ],
   "exit": 2,
   "stderr_contains": [
    "USAGE: missing value for --mode",
    "Cause: --mode requires a value",
    "Fix: --mode fast",
    "Alternative: --mode fast",
    "Alternative: --mode slow"
   ]
  },
  {
   "name": "invalid int value",
   "tree": "main",
   "args": [
    "deploy",
    "--count",
    "x"
   ],
   "exit": 2,
   "stderr_contains": [
    "USAGE: invalid argument \"x\" for \"--count\" flag",
    "Fix: run 'kitapp deploy --help' for usage"
   ]
  },
  {
   "name": "unknown command",
   "tree": "main",
   "args": [
    "ghost"
   ],
   "exit": 2,
   "stderr_contains": [
    "USAGE: unknown command \"ghost\" for \"kitapp\"",
    "Fix: run 'kitapp --help' for usage"
   ]
  },
  {
   "name": "unknown subcommand",
   "tree": "main",
   "args": [
    "router",
    "ghost"
   ],
   "exit": 2,
   "stderr_contains": [
    "USAGE: unknown command \"ghost\" for \"kitapp router\""
   ]
  },
  {
   "name": "near command is suggested",
   "tree": "main",
   "args": [
    "deplyo"
   ],
   "exit": 2,
   "stderr_contains": [
    "USAGE: unknown command \"deplyo\" for \"kitapp\"",
    "Did you mean this?",
    "\tdeploy"
   ]
  },
  {
   "name": "json envelope for an unknown flag",
   "tree": "main",
   "args": [
    "--format",
    "json",
    "deploy",
    "--evn",
    "prod"
   ],
   "exit": 2,
   "stderr_json": {
    "code": "USAGE",
    "message": "unknown flag --evn",
    "cause": "no flag named --evn on kitapp deploy",
    "suggested_fix": "--env",
    "exit_code": 2,
    "transience": "permanent"
   }
  },
  {
   "name": "json envelope for a missing value",
   "tree": "main",
   "args": [
    "--format",
    "json",
    "deploy",
    "--env"
