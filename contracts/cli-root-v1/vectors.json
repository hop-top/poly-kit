   ],
   "exit": 0,
   "stdout": "{\"args\":[],\"flags\":{},\"globals\":{\"format\":\"table\",\"no-color\":\"false\",\"no-hints\":\"false\",\"offline\":\"false\",\"quiet\":\"false\",\"verbose\":0},\"path\":\"router start\"}\n"
  },
  {
   "name": "autocorrect read applies on a read leaf",
   "tree": "main",
   "args": [
    "--autocorrect",
    "read",
    "ls",
    "--limt",
    "5"
   ],
   "exit": 0,
   "stdout": "{\"args\":[],\"flags\":{\"limit\":\"5\"},\"globals\":{\"format\":\"table\",\"no-color\":\"false\",\"no-hints\":\"false\",\"offline\":\"false\",\"quiet\":\"false\",\"verbose\":0},\"path\":\"ls\"}\n",
   "stderr_contains": [
    "OK: applied flag correction: --limt -> --limit",
    "Corrected from: --limt",
    "Fix: --limit"
   ]
  },
  {
   "name": "autocorrect read leaves a write leaf alone",
   "tree": "main",
   "args": [
    "--autocorrect",
    "read",
    "deploy",
    "--envv",
    "p"
   ],
   "exit": 2,
   "stderr_contains": [
    "USAGE: unknown flag --envv",
    "Fix: --env"
   ]
  },
  {
   "name": "autocorrect from the environment",
   "tree": "main",
   "args": [
    "ls",
    "--limt",
    "5"
   ],
   "exit": 0,
   "env": {
    "KIT_AUTOCORRECT": "read"
   },
   "stdout": "{\"args\":[],\"flags\":{\"limit\":\"5\"},\"globals\":{\"format\":\"table\",\"no-color\":\"false\",\"no-hints\":\"false\",\"offline\":\"false\",\"quiet\":\"false\",\"verbose\":0},\"path\":\"ls\"}\n",
   "stderr_contains": [
    "Corrected from: --limt"
   ]
  },
  {
   "name": "autocorrect flag beats the environment",
   "tree": "main",
   "args": [
    "--autocorrect",
    "off",
    "ls",
    "--limt",
    "5"
   ],
   "exit": 2,
   "env": {
    "KIT_AUTOCORRECT": "read"
   },
   "stderr_contains": [
    "USAGE: unknown flag --limt",
    "Fix: --limit"
   ]
  },
  {
   "name": "autocorrect off by default",
   "tree": "main",
   "args": [
    "ls",
    "--limt",
    "5"
   ],
   "exit": 2,
   "stderr_contains": [
    "USAGE: unknown flag --limt"
   ]
  },
  {
   "name": "help hides the management group",
   "tree": "main",
   "args": [
    "--help"
   ],
   "exit": 0,
   "stdout_contains": [
    "deploy",
    "ls",
    "router",
    "--help-all"
   ],
