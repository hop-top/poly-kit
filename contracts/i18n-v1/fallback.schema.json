{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hop.top/kit/contracts/i18n-v1/fallback.schema.json",
  "title": "i18n-v1 locale vectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["canonicalize", "likely_subtags", "parent", "chain", "resolve", "lookup"],
  "$defs": {
    "since": { "type": "string", "pattern": "^[0-9]+$" },
    "tag": { "type": "string" },
    "invalid": { "const": "invalid_locale" },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  },
  "properties": {
    "_comment": { "type": "array", "items": { "type": "string" } },
    "canonicalize": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["in", "out"],
            "properties": { "in": { "$ref": "#/$defs/tag" }, "out": { "type": "string", "minLength": 1 }, "since": { "$ref": "#/$defs/since" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["in", "error"],
            "properties": { "in": { "$ref": "#/$defs/tag" }, "error": { "$ref": "#/$defs/invalid" } }
          }
        ]
      }
    },
    "likely_subtags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "max"],
        "properties": { "tag": { "type": "string", "minLength": 1 }, "max": { "type": "string", "minLength": 1 }, "since": { "$ref": "#/$defs/since" } }
      }
    },
    "parent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "parent"],
        "properties": { "tag": { "type": "string", "minLength": 1 }, "parent": { "type": ["string", "null"] }, "since": { "$ref": "#/$defs/since" } }
      }
    },
    "chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tag", "default", "chain"],
            "properties": { "tag": { "type": "string" }, "default": { "type": "string" }, "chain": { "$ref": "#/$defs/tags" }, "since": { "$ref": "#/$defs/since" } }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tag", "default", "error"],
            "properties": { "tag": { "type": "string" }, "default": { "type": "string" }, "error": { "$ref": "#/$defs/invalid" } }
          }
        ]
      }
    },
    "resolve": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tag", "available", "default", "want"],
            "properties": {
              "tag": { "type": "string" },
              "available": { "type": "array", "items": { "type": "string" } },
              "default": { "type": "string" },
              "want": { "type": ["string", "null"] },
              "since": { "$ref": "#/$defs/since" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["tag", "available", "default", "error"],
            "properties": {
              "tag": { "type": "string" },
              "available": { "type": "array", "items": { "type": "string" } },
              "default": { "type": "string" },
              "error": { "$ref": "#/$defs/invalid" }
            }
          }
        ]
      }
    },
    "lookup": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "default", "catalogs", "keys"],
        "properties": {
          "tag": { "type": "string" },
          "default": { "type": "string" },
          "catalogs": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } },
          "keys": { "type": "object", "additionalProperties": { "type": ["string", "null"] } }
        }
      }
    }
  }
}
