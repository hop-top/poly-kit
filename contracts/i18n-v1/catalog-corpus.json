      "messages": {
        "greet": {
          "params": { "name": "string", "balance": "number", "day": "date" },
          "text": [
            { "t": "Bonjour " },
            { "p": "name" },
            { "t": ", solde " },
            { "p": "balance" },
            { "t": " au " },
            { "p": "day" },
            { "t": "." }
          ]
        }
