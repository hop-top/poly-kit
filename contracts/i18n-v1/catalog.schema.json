{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hop.top/kit/contracts/i18n-v1/catalog.schema.json",
  "title": "i18n-v1 message catalog",
  "description": "One catalog = one locale. Structural rules only; placeholder syntax, declared-vs-used parameters and the plural parameter's type are pinned by catalog-corpus.json (cases marked schema_gap), not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "locale", "messages"],
  "properties": {
    "$schema": { "type": "string" },
    "v": { "const": 1 },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "messages": { "$ref": "#/$defs/namespace" }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "node": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/leaf" },
        { "$ref": "#/$defs/nonEmptyNamespace" }
      ]
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^[A-Za-z0-9_-]+$": { "$ref": "#/$defs/node" } }
    },
    "nonEmptyNamespace": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": { "^[A-Za-z0-9_-]+$": { "$ref": "#/$defs/node" } }
    },
    "paramType": {
      "enum": ["string", "number", "integer", "date", "time", "datetime"]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Za-z_][A-Za-z0-9_]*$": { "$ref": "#/$defs/paramType" }
      }
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "$text": { "type": "string" },
        "$plural": {
          "type": "object",
          "additionalProperties": false,
          "required": ["on", "branches"],
          "properties": {
            "on": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "branches": {
              "type": "object",
              "additionalProperties": false,
              "required": ["other"],
              "properties": {
                "zero": { "type": "string" },
                "one": { "type": "string" },
                "two": { "type": "string" },
                "few": { "type": "string" },
                "many": { "type": "string" },
                "other": { "type": "string" }
              }
            }
          }
        },
        "$params": { "$ref": "#/$defs/params" },
        "$desc": { "type": "string" }
      },
      "oneOf": [{ "required": ["$text"] }, { "required": ["$plural"] }]
    }
  }
}
