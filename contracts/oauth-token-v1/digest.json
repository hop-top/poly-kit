{
  "_comment": [
    "Digest = first 16 lowercase hex chars of SHA-256 over `canonical`: JSON object with keys client_cert_ref, client_id, client_secret_ref, kind, scopes (sorted ascending by bytes, always an array), secret_ref, subject, token_url in that (alphabetical) order, no whitespace, absent strings as \"\", JSON string escaping per RFC 8259 minimal form plus \\u2028 and \\u2029, no HTML escaping.",
    "token_key = ref + \".token.\" + digest."
  ],
  "vectors": [
    {
      "name": "scopes sorted",
      "grant": {
        "v": 1,
        "kind": "client_credentials",
        "token_url": "https://idp.example/oauth2/token",
        "client_id": "client-1",
        "secret_ref": "uma/t/secret",
        "scopes": [
          "mail.read",
          "calendars.read"
        ],
        "subject": "user@example.test"
      },
      "canonical": "{\"client_cert_ref\":\"\",\"client_id\":\"client-1\",\"client_secret_ref\":\"\",\"kind\":\"client_credentials\",\"scopes\":[\"calendars.read\",\"mail.read\"],\"secret_ref\":\"uma/t/secret\",\"subject\":\"user@example.test\",\"token_url\":\"https://idp.example/oauth2/token\"}",
      "digest": "f6395ad51cfa40c3",
      "ref": "uma/t/oauth",
      "token_key": "uma/t/oauth.token.f6395ad51cfa40c3"
    },
    {
      "name": "scope order does not matter",
      "grant": {
        "v": 1,
        "kind": "client_credentials",
        "token_url": "https://idp.example/oauth2/token",
        "client_id": "client-1",
        "secret_ref": "uma/t/secret",
        "scopes": [
          "calendars.read",
          "mail.read"
        ],
        "subject": "user@example.test"
      },
      "canonical": "{\"client_cert_ref\":\"\",\"client_id\":\"client-1\",\"client_secret_ref\":\"\",\"kind\":\"client_credentials\",\"scopes\":[\"calendars.read\",\"mail.read\"],\"secret_ref\":\"uma/t/secret\",\"subject\":\"user@example.test\",\"token_url\":\"https://idp.example/oauth2/token\"}",
      "digest": "f6395ad51cfa40c3",
      "ref": "uma/t/oauth",
      "token_key": "uma/t/oauth.token.f6395ad51cfa40c3",
      "note": "same digest as previous"
    },
    {
      "name": "kind and secret_ref matter",
      "grant": {
        "v": 1,
        "kind": "refresh_token",
        "token_url": "https://idp.example/oauth2/token",
        "client_id": "client-1",
        "secret_ref": "uma/other/refresh",
        "scopes": [
          "mail.read",
          "calendars.read"
        ],
        "subject": "user@example.test"
      },
      "canonical": "{\"client_cert_ref\":\"\",\"client_id\":\"client-1\",\"client_secret_ref\":\"\",\"kind\":\"refresh_token\",\"scopes\":[\"calendars.read\",\"mail.read\"],\"secret_ref\":\"uma/other/refresh\",\"subject\":\"user@example.test\",\"token_url\":\"https://idp.example/oauth2/token\"}",
      "digest": "94ee45f5ee826206",
      "ref": "uma/t/oauth",
      "token_key": "uma/t/oauth.token.94ee45f5ee826206",
      "note": "different digest from the first vector: kind and secret_ref are in the digest"
    },
    {
      "name": "client_secret_ref matters",
      "grant": {
        "v": 1,
