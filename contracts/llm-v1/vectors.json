      "want_body": {
        "model": "m",
        "max_tokens": 1024,
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "document",
                "source": {
                  "type": "base64",
                  "media_type": "application/pdf",
                  "data": "JVBERi0x"
                }
              }
            ]
          }
        ]
      }
