    {
      "name": "empty",
      "uri": "",
      "error": "empty URI"
    },
    {
      "name": "missing scheme redacted",
      "uri": "openai/gpt-4?api_key=fake-secret-must-not-leak",
      "error": "missing scheme in URI \"openai/gpt-4?api_key=REDACTED\""
    },
    {
      "name": "empty scheme redacted",
      "uri": "://gpt-4?api_key=fake-secret-must-not-leak",
      "error": "empty scheme in URI \"://gpt-4?api_key=REDACTED\""
    }
  ],
  "anthropic_request": [
    {
      "name": "plain user turn",
      "adapter_model": "claude-sonnet-4-20250514",
      "request": {
        "messages": [
          {
            "role": "user",
            "content": "Hi"
          }
        ]
      },
      "want_body": {
        "model": "claude-sonnet-4-20250514",
        "max_tokens": 1024,
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "Hi"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "system, model override, zero temperature, limits",
      "adapter_model": "claude-sonnet-4-20250514",
      "request": {
        "model": "claude-opus-5-5",
        "temperature": 0,
        "max_tokens": 256,
        "stop_sequences": [
          "END"
        ],
        "messages": [
          {
            "role": "system",
            "content": "be brief"
          },
          {
            "role": "user",
            "content": "Hi"
          }
        ]
      },
      "want_body": {
        "model": "claude-opus-5-5",
        "max_tokens": 256,
        "temperature": 0,
        "stop_sequences": [
          "END"
        ],
        "system": [
          {
            "type": "text",
            "text": "be brief"
          }
        ],
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "Hi"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "last system message wins",
      "adapter_model": "m",
      "request": {
        "messages": [
          {
            "role": "system",
            "content": "first"
          },
          {
            "role": "user",
            "content": "Hi"
          },
          {
            "role": "system",
            "content": "second"
          }
        ]
      },
      "want_body": {
        "model": "m",
        "max_tokens": 1024,
        "system": [
          {
            "type": "text",
            "text": "second"
          }
        ],
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "Hi"
              }
            ]
          }
        ]
      }
    },
    {
      "name": "tool round merges results into one user turn",
      "adapter_model": "m",
      "request": {
        "messages": [
          {
            "role": "system",
            "content": "sys"
          },
          {
            "role": "user",
            "content": "Weather in NYC and LA?"
          },
          {
            "role": "assistant",
            "content": "Checking.",
            "tool_calls": [
              {
                "id": "call_1",
                "name": "get_weather",
                "arguments": "{\"city\":\"NYC\"}"
              },
              {
                "id": "call_2",
                "name": "get_weather",
                "arguments": "{\"city\":\"LA\"}"
              }
            ]
          },
          {
            "role": "tool",
            "tool_call_id": "call_1",
            "content": "sunny"
          },
          {
            "role": "tool",
            "tool_call_id": "call_2",
            "content": "rainy"
          }
        ]
      },
      "tools": [
        {
          "name": "get_weather",
          "description": "Current weather",
          "parameters": "{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"}},\"required\":[\"city\"]}"
        }
      ],
      "want_body": {
        "model": "m",
        "max_tokens": 1024,
        "system": [
          {
            "type": "text",
            "text": "sys"
          }
        ],
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "Weather in NYC and LA?"
              }
            ]
          },
          {
            "role": "assistant",
            "content": [
              {
                "type": "text",
                "text": "Checking."
              },
              {
                "type": "tool_use",
                "id": "call_1",
                "name": "get_weather",
                "input": {
                  "city": "NYC"
                }
              },
              {
                "type": "tool_use",
                "id": "call_2",
                "name": "get_weather",
                "input": {
                  "city": "LA"
                }
              }
            ]
          },
          {
            "role": "user",
            "content": [
              {
                "type": "tool_result",
                "tool_use_id": "call_1",
                "content": [
                  {
                    "type": "text",
                    "text": "sunny"
                  }
                ]
              },
              {
                "type": "tool_result",
                "tool_use_id": "call_2",
                "content": [
                  {
                    "type": "text",
                    "text": "rainy"
                  }
                ]
              }
            ]
          }
        ],
        "tools": [
          {
            "name": "get_weather",
            "description": "Current weather",
            "input_schema": {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                }
              },
              "required": [
                "city"
              ]
            }
          }
        ]
      }
    },
