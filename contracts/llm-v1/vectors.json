  "anthropic_request_error": [
    {
      "name": "tool calls on a user turn",
      "request": {
        "messages": [
          {
            "role": "user",
            "content": "x",
            "tool_calls": [
              {
                "id": "c",
                "name": "t"
              }
            ]
          }
        ]
      },
      "error": "anthropic: ToolCalls are valid only on role assistant, got \"user\""
    },
    {
      "name": "tool call id on a user turn",
      "request": {
        "messages": [
          {
            "role": "user",
            "content": "x",
            "tool_call_id": "c"
          }
        ]
      },
      "error": "anthropic: ToolCallID is valid only on role tool, got \"user\""
    },
    {
      "name": "tool result without id",
      "request": {
        "messages": [
          {
            "role": "tool",
            "content": "x"
          }
        ]
      },
      "error": "anthropic: tool result needs ToolCallID"
    },
    {
      "name": "tool result with parts",
      "request": {
        "messages": [
          {
            "role": "tool",
            "tool_call_id": "c",
            "parts": [
              {
                "type": "text",
                "text": "x"
              }
            ]
          }
        ]
      },
      "error": "anthropic: tool result \"c\" carries only Content"
    },
    {
      "name": "tool call without id",
      "request": {
        "messages": [
          {
            "role": "assistant",
            "tool_calls": [
              {
                "name": "ping"
              }
            ]
          }
        ]
      },
      "error": "anthropic: tool call \"ping\" needs an ID"
    },
    {
      "name": "tool call arguments not JSON",
      "request": {
        "messages": [
          {
            "role": "assistant",
            "tool_calls": [
              {
                "id": "call_1",
                "name": "ping",
                "arguments": "{nope"
              }
            ]
          }
        ]
      },
      "error": "anthropic: tool call \"call_1\" arguments are not valid JSON"
    }
  ],
