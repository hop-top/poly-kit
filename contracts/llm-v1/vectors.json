{
  "version": "v1",
  "description": "Provider-neutral llm core and the anthropic adapter. Go is canonical. redact_uri: credential masking of provider URIs (RedactURI). parse_uri: scheme://[host:port/]model[?params] parsing; error is the exact message. anthropic_request: the Messages API body an adapter sends for a request (tools present: tool-calling call, else completion), compared as JSON. anthropic_request_error: requests the adapter rejects before sending, exact message. anthropic_headers: auth and routing headers from the key and the ANTHROPIC_* environment. anthropic_stream: text tokens a stream yields from an SSE body, then done or an error. anthropic_accumulate: the message an SSE body folds into (the Go SDK's Message.Accumulate). anthropic_error: how HTTP responses map to error kinds, whether the kind is fallbackable, and how many attempts the default retry policy makes; the last response repeats. Retry waits a server asks for are honored only within (0, 60s]; other values fall back to backoff. key_endpoint: where a resolved key may go (op apply: ApplyAPIKey's URI, or refused; op load: LoadConfig refused or not; op resolve: Resolve with the URI's own key refused or not): a key from llm.yaml or the environment reaches a URI-named endpoint only when loopback or the same origin as the provider's default or configured endpoint, a URI's own key any https host, and no key goes over plain http to a remote host. credential_headers: the credentials the anthropic adapter sends for a base URL; ANTHROPIC_AUTH_TOKEN and ANTHROPIC_WORKSPACE_ID go only to a trusted origin (the default endpoint, ANTHROPIC_BASE_URL, llm.yaml base_url, LLM_BASE_URL, loopback), and plain http to a remote host is refused.",
  "redact_uri": [
    {
      "name": "api_key",
      "in": "openrouter://openai/gpt-4?api_key=fake-secret-must-not-leak",
      "want": "openrouter://openai/gpt-4?api_key=REDACTED"
    },
    {
      "name": "key",
      "in": "google://gemini-2.0-flash?key=fake-secret-must-not-leak",
      "want": "google://gemini-2.0-flash?key=REDACTED"
    },
    {
      "name": "name case and hyphen",
      "in": "openai://gpt-4?X-API-Key=fake-secret-must-not-leak",
      "want": "openai://gpt-4?X-API-Key=REDACTED"
    },
    {
      "name": "token",
      "in": "openai://gpt-4?access_token=fake-secret-must-not-leak",
      "want": "openai://gpt-4?access_token=REDACTED"
    },
    {
      "name": "secret",
      "in": "openai://gpt-4?client_secret=fake-secret-must-not-leak",
      "want": "openai://gpt-4?client_secret=REDACTED"
    },
    {
      "name": "password",
      "in": "openai://gpt-4?password=fake-secret-must-not-leak",
      "want": "openai://gpt-4?password=REDACTED"
    },
    {
      "name": "signature",
      "in": "https://cdn.example/a.png?X-Amz-Signature=fake-secret-must-not-leak",
      "want": "https://cdn.example/a.png?X-Amz-Signature=REDACTED"
    },
    {
      "name": "escaped name",
      "in": "openai://gpt-4?api%5Fkey=fake-secret-must-not-leak",
      "want": "openai://gpt-4?api%5Fkey=REDACTED"
    },
    {
      "name": "multiple params",
      "in": "openai://gpt-4?temperature=0.2&api_key=fake-secret-must-not-leak&key=fake-secret-must-not-leak&base_url=http://h:1/v1",
      "want": "openai://gpt-4?temperature=0.2&api_key=REDACTED&key=REDACTED&base_url=http://h:1/v1"
    },
    {
      "name": "fragment after key",
      "in": "openai://gpt-4?api_key=fake-secret-must-not-leak#frag",
      "want": "openai://gpt-4?api_key=REDACTED"
    },
    {
      "name": "userinfo with password",
      "in": "openai://user:fake-secret-must-not-leak@proxy:8080/gpt-4",
      "want": "openai://REDACTED@proxy:8080/gpt-4"
    },
    {
      "name": "userinfo token before path",
      "in": "openai://fake-secret-must-not-leak@proxy/gpt-4",
      "want": "openai://REDACTED@proxy/gpt-4"
    },
    {
      "name": "http userinfo without path",
      "in": "https://fake-secret-must-not-leak@proxy",
      "want": "https://REDACTED@proxy"
    },
    {
      "name": "net/http masked password",
      "in": "http://user:***@h/x",
      "want": "http://REDACTED@h/x"
    },
    {
      "name": "base_url userinfo",
      "in": "openai://gpt-4?base_url=https://fake-secret-must-not-leak@proxy",
      "want": "openai://gpt-4?base_url=https://REDACTED@proxy"
    },
    {
      "name": "base_url nested query",
      "in": "openai://gpt-4?base_url=https://h/v1?key=fake-secret-must-not-leak",
      "want": "openai://gpt-4?base_url=https://h/v1?key=REDACTED"
    },
    {
      "name": "malformed: missing scheme",
      "in": "openai/gpt-4?api_key=fake-secret-must-not-leak",
      "want": "openai/gpt-4?api_key=REDACTED"
    },
    {
      "name": "malformed: empty scheme",
      "in": "://gpt-4?api_key=fake-secret-must-not-leak",
      "want": "://gpt-4?api_key=REDACTED"
    },
    {
      "name": "malformed: & without ?",
      "in": "openai://gpt-4&api_key=fake-secret-must-not-leak",
      "want": "openai://gpt-4&api_key=REDACTED"
    },
    {
      "name": "malformed: doubled ?",
      "in": "openai://gpt-4??api_key=fake-secret-must-not-leak",
      "want": "openai://gpt-4??api_key=REDACTED"
    },
    {
      "name": "malformed: bare param",
      "in": "api_key=fake-secret-must-not-leak",
      "want": "api_key=REDACTED"
    },
    {
      "name": "malformed: no scheme userinfo",
      "in": "user:fake-secret-must-not-leak@host/model",
      "want": "REDACTED@host/model"
    },
    {
      "name": "empty",
      "in": "",
      "want": ""
    },
    {
      "name": "plain",
      "in": "openai://gpt-4o",
      "want": "openai://gpt-4o"
    },
    {
      "name": "host form",
      "in": "ollama://localhost:11434/llama3?temperature=0.5",
      "want": "ollama://localhost:11434/llama3?temperature=0.5"
    },
    {
      "name": "look-alike names",
      "in": "openai://gpt-4?max_tokens=10&keyword=a&top_k=3&monkey=1",
      "want": "openai://gpt-4?max_tokens=10&keyword=a&top_k=3&monkey=1"
    },
    {
      "name": "empty key value",
      "in": "openai://gpt-4?api_key=",
      "want": "openai://gpt-4?api_key="
    },
    {
      "name": "model@version",
      "in": "vertex://claude-3-5-sonnet@20240620",
      "want": "vertex://claude-3-5-sonnet@20240620"
    },
    {
      "name": "@ in model path",
      "in": "openrouter://openai/gpt-4@latest",
      "want": "openrouter://openai/gpt-4@latest"
    },
    {
      "name": "already redacted",
      "in": "openai://REDACTED@h/m?api_key=REDACTED",
      "want": "openai://REDACTED@h/m?api_key=REDACTED"
    }
  ],
