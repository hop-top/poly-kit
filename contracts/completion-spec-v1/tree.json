{
  "version": "v1",
  "description": "Fixture command tree for the completion-spec-v1 corpus. Each port rebuilds this tree in its own CLI framework, exports it as a completion spec, and must produce expected.fig.js and expected.usage.kdl byte for byte. Field meanings are in README.md.",
  "root": {
    "use": "ac'me{1}",
    "short": "Acme ships widgets",
    "version": "1.4.0",
    "flags": [
      { "name": "help", "short": "h", "type": "bool", "usage": "help for acme" },
      { "name": "verbose", "short": "v", "type": "count", "usage": "More output; repeat for more", "persistent": true },
      {
        "name": "format",
        "type": "string",
        "usage": "Output format (one of: json, yaml, text)",
        "persistent": true,
        "enum": ["json", "yaml", "text"]
      },
      {
        "name": "config",
        "short": "c",
        "type": "string",
        "usage": "Read settings from `file`",
        "persistent": true,
        "hidden": true,
        "filename_ext": ["yaml", ".yml"]
      }
    ],
    "commands": [
      {
        "use": "get <id>",
        "short": "Show one widget",
        "aliases": ["g", "show"],
        "valid_args_function": true,
        "flags": [
          { "name": "owner", "type": "string", "usage": "Filter by owner `name`", "completion_function": true },
          { "name": "output-dir", "short": "o", "type": "string", "usage": "Write into `dir`", "dirname": true },
          { "name": "attach", "type": "string", "usage": "Attach a file", "filename_ext": [] }
        ]
      },
      {
        "use": "list [filter...]",
        "short": "List widgets: all of them",
        "flags": [
          { "name": "label", "short": "l", "type": "stringSlice", "usage": "Only widgets with `label`" },
          {
            "name": "status",
            "type": "string",
            "usage": "Widget status (one of: TODO, DONE)",
            "required": true,
            "enum": ["TODO", "DONE"],
            "completion_function": true
          },
          { "name": "all", "short": "a", "type": "bool", "usage": "Include archived" },
          { "name": "limit", "type": "int", "usage": "At most this many" }
        ]
      },
      {
        "use": "deploy",
        "short": "Deploy \"stable\" builds\u2028now",
        "annotations": { "kit/args": "target, region?" },
        "valid_args": ["prod\tProduction", "staging"],
        "flags": [
          { "name": "wait", "type": "duration", "usage": "Wait for rollout", "no_opt_default": "30s" },
          { "name": "tag", "type": "stringArray", "usage": "Image tag" },
          { "name": "force", "type": "bool", "usage": "Skip checks", "deprecated": "use --yes" }
        ]
      },
      {
        "use": "widget",
        "short": "Manage widgets",
        "flags": [
          { "name": "store", "type": "string", "usage": "Store at C:\\data — see \"docs\"", "persistent": true }
        ],
        "commands": [
          { "use": "add NAME [TAGS...]", "short": "Add a widget" },
          { "use": "rm <id>... [flags]", "short": "Remove widgets" }
        ]
      },
      { "use": "legacy", "short": "Old entry point", "deprecated": "use get" },
      { "use": "watch", "short": "Follow widget events", "valid_args_function": true },
      { "use": "ping <host>", "short": "Check the service", "no_args": true, "valid_args_function": true },
      { "use": "explain [topic | command]", "short": "Explain a topic" },
      {
        "use": "esc",
        "short": "c0\u0001 nul\u0000 nl\n cr\r tab\t bs\b ff\f del\u007f nel\u0085 lrm\u200e rlm\u200f lre\u202a rlo\u202e lri\u2066 pdi\u2069 bom\ufeff ls\u2028 ps\u2029 q\" bk\\ ${x} `tick` /* c */ {a}; k=v #true // \u00e9",
        "aliases": ["e\"sc", "e\u0085sc"],
        "valid_args": ["a\nb", "c\u2029d\tignored description"],
        "flags": [
          { "name": "mode", "type": "string", "usage": "Mode \u0001\u007f\u0085 `tick` ${y} \"q\" \\ \u2029", "enum": ["\u202e", "x\u0000y", "q\"'"] }
        ]
      },
      {
        "use": "internal",
        "short": "Maintenance hooks",
        "hidden": true,
        "flags": [{ "name": "token", "type": "string", "usage": "Access token" }]
      }
    ]
  }
}
