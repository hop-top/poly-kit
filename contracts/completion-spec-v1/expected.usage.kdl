// Generated by `acme completion usage`. Do not edit.
name "acme"
bin "acme"
about "Acme ships widgets"
flag "-c --config <file>" help="Read settings from file" global=#true hide=#true {
    complete type="file:yaml,yml"
}
flag "--format <string>" help="Output format (one of: json, yaml, text)" global=#true {
    choices strict=#false "json" "yaml" "text"
}
flag "-v --verbose" help="More output; repeat for more" global=#true count=#true
flag "--version" help="version for acme"
cmd "deploy" help="Deploy \"stable\" builds\u{2028}now" {
    flag "--force" help="Skip checks" hide=#true
    flag "--tag <stringArray>" help="Image tag" var=#true
    flag "--wait [duration]" help="Wait for rollout"
    arg "<target>" {
        choices strict=#false "prod" "staging"
    }
    arg "[region]" {
        choices strict=#false "prod" "staging"
    }
}
cmd "explain" help="Explain a topic" {
    arg "[topic|command]"
}
cmd "get" help="Show one widget" {
    alias "g" "show"
    flag "--attach <string>" help="Attach a file" {
        complete type="file"
    }
    flag "-o --output-dir <dir>" help="Write into dir" {
        complete type="dir"
    }
    flag "--owner <name>" help="Filter by owner name" {
        complete run="acme __complete{% for w in words %}{% if loop.index0 > 0 and loop.index0 <= CURRENT %} {{ w | shell_quote }}{% endif %}{% endfor %} 2>/dev/null | awk -F '\\t' '/^:[0-9]+$/ { exit } /^_activeHelp_ / { next } { v = $1; gsub(/:/, \"\\\\:\", v); if (NF > 1) print v \":\" $2; else print v }'" descriptions=#true
    }
    arg "<id>" {
        complete run="acme __complete{% for w in words %}{% if loop.index0 > 0 and loop.index0 <= CURRENT %} {{ w | shell_quote }}{% endif %}{% endfor %} 2>/dev/null | awk -F '\\t' '/^:[0-9]+$/ { exit } /^_activeHelp_ / { next } { v = $1; gsub(/:/, \"\\\\:\", v); if (NF > 1) print v \":\" $2; else print v }'" descriptions=#true
    }
}
cmd "internal" help="Maintenance hooks" hide=#true {
    flag "--token <string>" help="Access token"
}
cmd "legacy" help="Old entry point" hide=#true
cmd "list" help="List widgets: all of them" {
    flag "-a --all" help="Include archived"
    flag "-l --label <label>" help="Only widgets with label" var=#true
    flag "--limit <int>" help="At most this many"
    flag "--status <string>" help="Widget status (one of: TODO, DONE)" required=#true {
        choices strict=#false "TODO" "DONE"
    }
    arg "[filter]" var=#true
}
cmd "ping" help="Check the service"
cmd "watch" help="Follow widget events" {
    arg "[arg]" var=#true {
        complete run="acme __complete{% for w in words %}{% if loop.index0 > 0 and loop.index0 <= CURRENT %} {{ w | shell_quote }}{% endif %}{% endfor %} 2>/dev/null | awk -F '\\t' '/^:[0-9]+$/ { exit } /^_activeHelp_ / { next } { v = $1; gsub(/:/, \"\\\\:\", v); if (NF > 1) print v \":\" $2; else print v }'" descriptions=#true
    }
}
cmd "widget" help="Manage widgets" {
    flag "--store <string>" help="Store at C:\\data — see \"docs\"" global=#true
    cmd "add" help="Add a widget" {
        arg "<NAME>"
        arg "[TAGS]" var=#true
    }
    cmd "rm" help="Remove widgets" {
        arg "<id>" var=#true
    }
}
