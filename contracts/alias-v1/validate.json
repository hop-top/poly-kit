{
  "version": "v1",
  "description": "Standalone alias name validation. Rules run in order and the first failure is reported: `empty` (the name is the empty string), `whitespace` (the name holds any character with the Unicode White_Space property), `builtin` (the name equals one of `builtins`, compared exactly), `duplicate` (the name is a key of `existing`). `expect` is `ok` or the failing rule's kind. Absent `builtins` and `existing` are empty.",
  "cases": [
    { "name": "plain name", "alias": "tl", "expect": "ok" },
    { "name": "hyphen and digits", "alias": "deploy-2", "expect": "ok" },
    { "name": "non-ascii letters", "alias": "déploy", "expect": "ok" },
    { "name": "empty", "alias": "", "expect": "empty" },
    { "name": "space inside", "alias": "a b", "expect": "whitespace" },
    { "name": "leading space", "alias": " a", "expect": "whitespace" },
    { "name": "only spaces", "alias": "  ", "expect": "whitespace" },
    { "name": "tab", "alias": "a\tb", "expect": "whitespace" },
    { "name": "trailing newline", "alias": "a\n", "expect": "whitespace" },
    { "name": "carriage return", "alias": "a\rb", "expect": "whitespace" },
    { "name": "vertical tab", "alias": "a\u000bb", "expect": "whitespace" },
    { "name": "form feed", "alias": "a\u000cb", "expect": "whitespace" },
    { "name": "next line", "alias": "a\u0085b", "expect": "whitespace" },
    { "name": "no-break space", "alias": "a b", "expect": "whitespace" },
    { "name": "ideographic space", "alias": "a　b", "expect": "whitespace" },
    { "name": "line separator", "alias": "a b", "expect": "whitespace" },
    { "name": "byte order mark is not white space", "alias": "a﻿b", "expect": "ok" },
    { "name": "information separator is not white space", "alias": "a\u001cb", "expect": "ok" },
    { "name": "zero width space is not white space", "alias": "a​b", "expect": "ok" },
    { "name": "builtin", "alias": "task", "builtins": ["help", "task"], "expect": "builtin" },
    { "name": "builtin compare is exact", "alias": "Task", "builtins": ["task"], "expect": "ok" },
    { "name": "builtin prefix is not a match", "alias": "ta", "builtins": ["task"], "expect": "ok" },
    { "name": "duplicate", "alias": "d", "existing": { "d": "deploy" }, "expect": "duplicate" },
    { "name": "other aliases do not collide", "alias": "dp", "existing": { "d": "deploy" }, "expect": "ok" },
    { "name": "empty before builtin", "alias": "", "builtins": [""], "expect": "empty" },
    { "name": "whitespace before builtin", "alias": "a b", "builtins": ["a b"], "expect": "whitespace" },
    { "name": "builtin before duplicate", "alias": "task", "builtins": ["task"], "existing": { "task": "task list" }, "expect": "builtin" },
    { "name": "all rules pass", "alias": "tl", "builtins": ["task", "help"], "existing": { "d": "deploy" }, "expect": "ok" }
  ]
}
