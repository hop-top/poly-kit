{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hop.top/kit/contracts/breaker-v1/breaker.json",
  "version": "v1",
  "description": "Breaker (Go `core/breaker`): circuit state machine, MaxOps/MaxBytes budgets, bursty rate limiter, OnTrip halt/warn/degrade, logs and bus events. Each scenario builds a breaker named after the scenario on a fake clock, `config` mapping to the options (zero or absent circuit fields keep the defaults 5/1/30s), and runs `steps` in order: `allow` (want ok or broken), `record` (success, n bytes), `advance` (ms on the fake clock), `state` (want closed, open or half_open), `trip` (reason), `reset`, `stats` (trips, last_trip_reason, last_trip_at_ms since the fake epoch or null, counters). `logs` is every log record in order: level, msg and the full field set. With `publisher` true, `events` is every bus event as a multiset (publication is fire-and-forget, so order is not pinned), payload as Go's encoding/json writes it: states are ints (closed 0, open 1, half_open 2). Rate vectors stay inside the first period: Go's limiter reads failsafe-go's wall clock, not the fake one. `topic_prefixes` pins the composed topics or the panic text.",
  "source": "core.breaker",
  "default_topics": {
    "tripped": "kit.core.breaker.tripped",
    "opened": "kit.core.breaker.opened",
    "closed": "kit.core.breaker.closed",
    "half_opened": "kit.core.breaker.half_opened"
  },
