      "frame": "{\"topic\":\"kit.test.frame.sent\",\"source\":\"s\",\"timestamp\":\"2026-10-25T12:00:00+24:60\",\"origin\":\"o\"}",
      "ok": true,
      "kind": "kit",
      "origin": "o",
      "event": {
        "topic": "kit.test.frame.sent",
        "source": "s",
        "timestamp": "2026-10-24T11:00:00Z"
      }
    },
    {
      "name": "kit frame timestamp offset hour 25",
      "frame": "{\"topic\":\"kit.test.frame.sent\",\"source\":\"s\",\"timestamp\":\"2026-10-25T12:00:00+25:00\"}",
      "ok": false
    },
    {
      "name": "kit frame timestamp offset minute 61",
      "frame": "{\"topic\":\"kit.test.frame.sent\",\"source\":\"s\",\"timestamp\":\"2026-10-25T12:00:00+00:61\"}",
      "ok": false
    },
    {
      "name": "null frame",
      "frame": "null",
      "ok": false
    },
    {
      "name": "string frame",
      "frame": "\"x\"",
      "ok": false
    },
    {
