{
  "version": "v1",
  "description": "CloudEvents 1.0 structured-mode JSON decoding. `input` is the raw document text. ok cases: `canonical` is the re-encoded CloudEvent (compared as JSON values; `time` therefore compared as an exact string), and `event`, when present, is the kit Event it maps to; `event_error`, when present, is the exact error mapping to an Event returns. Failing cases: `error` is the exact text. JSON null members count as unset. First failure wins: document, then string attributes in the order specversion, id, source, type, subject, time, datacontenttype, dataschema (type, emptiness, time grammar), then data/data_base64, then extensions by ascending name (name, then value), then required/specversion checks. Vectors avoid invalid UTF-8, lone surrogates and duplicate keys, where JSON libraries disagree.",
  "cases": [
    {
      "name": "minimal",
      "input": "{\"specversion\":\"1.0\",\"id\":\"x\",\"source\":\"s\",\"type\":\"t\"}",
      "ok": true,
      "canonical": {
        "specversion": "1.0",
        "id": "x",
        "source": "s",
        "type": "t"
      },
      "event": {
        "id": "x",
        "topic": "t",
        "source": "s"
      }
    },
    {
      "name": "all attributes",
      "input": "{\"specversion\":\"1.0\",\"id\":\"ce-1\",\"source\":\"/acme/core\",\"type\":\"acme.core.stream.reset\",\"subject\":\"order-42\",\"time\":\"2026-10-25T08:00:00.5-04:00\",\"datacontenttype\":\"application/json\",\"dataschema\":\"https://example.com/s.json\",\"data\":{\"n\":1},\"tenantid\":\"t1\",\"seqoffset\":42,\"live\":false,\"workspaceid\":\"ws1\"}",
      "ok": true,
      "canonical": {
        "specversion": "1.0",
        "id": "ce-1",
        "source": "/acme/core",
        "type": "acme.core.stream.reset",
        "subject": "order-42",
        "time": "2026-10-25T12:00:00.5Z",
        "datacontenttype": "application/json",
        "dataschema": "https://example.com/s.json",
        "live": false,
        "seqoffset": 42,
        "tenantid": "t1",
        "workspaceid": "ws1",
        "data": {
          "n": 1
        }
      },
      "event": {
        "id": "ce-1",
        "topic": "acme.core.stream.reset",
        "source": "/acme/core",
        "timestamp": "2026-10-25T12:00:00.5Z",
        "subject": "order-42",
        "datacontenttype": "application/json",
        "dataschema": "https://example.com/s.json",
        "payload": {
          "n": 1
        },
        "workspace_id": "ws1",
        "extensions": {
          "tenantid": "t1",
          "seqoffset": 42,
          "live": false
        }
      }
    },
    {
      "name": "null members are unset",
      "input": "{\"specversion\":\"1.0\",\"id\":\"x\",\"source\":\"s\",\"type\":\"t\",\"subject\":null,\"time\":null,\"data\":null,\"gone\":null}",
      "ok": true,
      "canonical": {
        "specversion": "1.0",
        "id": "x",
        "source": "s",
        "type": "t"
      },
      "event": {
        "id": "x",
        "topic": "t",
        "source": "s"
      }
    },
    {
      "name": "data_base64 null is unset",
      "input": "{\"specversion\":\"1.0\",\"id\":\"x\",\"source\":\"s\",\"type\":\"t\",\"data_base64\":null}",
      "ok": true,
      "canonical": {
        "specversion": "1.0",
        "id": "x",
        "source": "s",
        "type": "t"
      },
      "event": {
        "id": "x",
        "topic": "t",
        "source": "s"
      }
    },
    {
      "name": "string \"null\" data survives",
      "input": "{\"specversion\":\"1.0\",\"id\":\"x\",\"source\":\"s\",\"type\":\"t\",\"data\":\"null\"}",
      "ok": true,
      "canonical": {
        "specversion": "1.0",
        "id": "x",
        "source": "s",
        "type": "t",
        "data": "null"
      },
      "event": {
        "id": "x",
        "topic": "t",
        "source": "s",
        "payload": "null"
      }
    },
    {
      "name": "data is compacted",
      "input": "{\"specversion\":\"1.0\",\"id\":\"x\",\"source\":\"s\",\"type\":\"t\",\"data\": { \"a\" : [ 1 , 2 ] }}",
      "ok": true,
      "canonical": {
        "specversion": "1.0",
        "id": "x",
        "source": "s",
        "type": "t",
        "data": {
