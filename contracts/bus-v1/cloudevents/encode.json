      "event": {
        "id": "evt_01jg000000e008000000000000",
        "topic": "kit.test.order.created",
        "source": "kit.checkout",
        "extensions": {
          "subject": "x"
        }
      },
      "ok": false,
      "error": "cloudevents: subject: reserved attribute name"
    },
