{
  "version": "v1",
  "description": "Control frames. classify: a frame that is not a JSON object is dropped; a member named exactly `specversion` makes a CloudEvents event; on a stream link only, a string member `type` makes a control frame; anything else is a kit event. acceptor: how an acceptor handles a control frame from its dialer: `request` (subscribe/unsubscribe, normalized; an absent `patterns` or `scope` key means the member was absent or null), `reply` (an `error` frame with `code`, echoing `id` only when the frame carried a valid id), or `ignore`. dialer: how a dialer handles a control frame from its acceptor: `ack`, `error`, `reset`, `position`, `ignore`, or `protocol_error` (close 1002). apply: applying a request to a link's subscription state; `patterns` null is the implicit `#`; `max` is the subscription cap; `effective` is what the authorizer sees (sorted patterns, implicit as [\"#\"]). A dialer `protocol_error` names its `kind`.",
  "classify": [
    {
      "name": "cloudevents on a stream link",
      "frame": "{\"specversion\":\"1.0\",\"type\":\"acme.crm.deal.created\"}",
      "stream_link": true,
      "kind": "cloudevents"
    },
    {
      "name": "control on a stream link",
      "frame": "{\"type\":\"ack\",\"id\":\"s1\",\"at\":\"3\"}",
      "stream_link": true,
      "kind": "control"
    },
    {
      "name": "type on a legacy link is a kit frame",
      "frame": "{\"type\":\"ack\",\"id\":\"s1\"}",
      "stream_link": false,
      "kind": "kit"
    },
    {
      "name": "non-string type is a kit frame",
      "frame": "{\"type\":7,\"topic\":\"a.b.c.d\"}",
      "stream_link": true,
      "kind": "kit"
    },
    {
      "name": "null type is a kit frame",
      "frame": "{\"type\":null,\"topic\":\"a.b.c.d\"}",
      "stream_link": true,
      "kind": "kit"
    },
    {
      "name": "kit frame on a stream link",
      "frame": "{\"topic\":\"a.b.c.d\",\"offset\":\"1\"}",
      "stream_link": true,
      "kind": "kit"
    },
    {
      "name": "specversion wins over type",
      "frame": "{\"specversion\":null,\"type\":\"subscribe\"}",
      "stream_link": true,
      "kind": "cloudevents"
    },
    {
      "name": "case-folded Type is a kit frame",
      "frame": "{\"Type\":\"ack\"}",
      "stream_link": true,
      "kind": "kit"
    },
    {
      "name": "array dropped",
      "frame": "[\"subscribe\"]",
      "stream_link": true,
      "kind": "drop"
    },
    {
      "name": "null dropped",
      "frame": "null",
      "stream_link": true,
      "kind": "drop"
    },
    {
      "name": "not JSON dropped",
      "frame": "{type:",
      "stream_link": false,
      "kind": "drop"
    }
  ],
