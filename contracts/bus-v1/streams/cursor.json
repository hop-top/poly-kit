          "id": "S",
          "oldest": "17",
          "head": "57"
        },
        "resume": {
          "status": "replaying",
          "after": "41",
          "head": "57"
        }
      },
      "frames": [
        {
          "event": "42"
        },
        {
          "event": "41"
        },
        {
          "event": "42"
        },
        {
          "event": "50"
        },
        {
          "position": {
            "stream": "S",
            "offset": "57"
          }
        },
        {
          "event": "56"
        },
        {
          "event": "58"
        }
      ],
      "expect": {
        "link_up": {
          "resume": "replaying",
          "invalidated": null
        },
        "frames": [
          "deliver",
          "drop",
          "drop",
          "deliver",
          "ok",
          "drop",
          "deliver"
        ],
        "position": {
          "stream": "S",
          "offset": "58"
        }
      }
    },
    {
      "name": "evicted reset in the ack",
      "seed": {
        "stream": "S",
