    {"name": "future version and unknown keys", "frame": "{\"auth\":\"t\",\"caps\":{\"streams\":7,\"frames\":[\"cloudevents\",\"protobuf\"],\"x\":1},\"origin\":\"o\",\"session\":{\"window\":5},\"next\":true}", "ok": true, "token": "t", "caps": {"streams": 7, "frames": ["cloudevents"]}, "origin": "o", "session": {"subscribe": null, "scope": null, "resume": null}},
    {"name": "lenient caps", "frame": "{\"auth\":\"t\",\"caps\":{\"streams\":\"1\",\"frames\":\"kit\"},\"origin\":5}", "ok": true, "token": "t", "caps": {"streams": 0, "frames": []}, "origin": "", "session": null},
