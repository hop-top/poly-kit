{
  "version": "v1",
  "description": "redact-v1: rules applied to text. Each vector runs one policy (inline `rules`, else rules.json) under one strategy; `findings` are Scan results before merging, `spans` the merged regions Apply replaces, `output` the redacted text. Offsets are UTF-8 byte offsets. `pad` wraps input and output in `text` repeated `times` times; offsets exclude it.",
  "vectors": [
    {
      "name": "overlap-earliest-start-wins",
      "rules": [
        {
          "id": "short",
          "regex": "abcd"
        },
        {
          "id": "long",
          "regex": "abcdef"
        },
        {
          "id": "tail",
          "regex": "defgh"
        }
      ],
      "strategy": "tag",
      "input": "x abcdefgh y",
      "findings": [
        {
          "rule": "short",
          "start": 2,
          "end": 6
        },
        {
          "rule": "long",
          "start": 2,
          "end": 8
        },
        {
          "rule": "tail",
          "start": 5,
          "end": 10
        }
      ],
      "spans": [
        {
          "rule": "long",
          "start": 2,
          "end": 10
        }
      ],
      "output": "x <long> y"
    },
